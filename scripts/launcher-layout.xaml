<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roblox Workshop" Width="1180" Height="800"
        WindowStartupLocation="CenterScreen" MinWidth="1000" MinHeight="680"
        Background="#11110F" FontFamily="Bahnschrift, Segoe UI">
    <Grid Background="#11110F">
        <Image x:Name="ShellTexture" Stretch="UniformToFill" Opacity="0.18" IsHitTestVisible="False"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="88"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="178"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Machined header rail -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#B77A2A" BorderThickness="0,0,0,3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#302D26" Offset="0"/>
                        <GradientStop Color="#171613" Offset="0.56"/>
                        <GradientStop Color="#0D0C0A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="22,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="210"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="WorkshopEmblem" Width="56" Height="56" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="ROBLOX WORKSHOP" Foreground="#F2E7CE" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="Shared creator console" Foreground="#9F8A66" FontSize="12" Margin="1,3,0,0"/>
                    </StackPanel>
                    <Image x:Name="HeaderGauge" Grid.Column="2" Width="72" Height="72" Stretch="Uniform"/>
                    <Border Grid.Column="3" Margin="12,8,0,8" Background="#11110F" BorderBrush="#705025" BorderThickness="2" CornerRadius="3" Padding="12,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Ellipse Width="15" Height="15" Fill="#E5A72B" Stroke="#D2A74D" StrokeThickness="2" VerticalAlignment="Center">
                                <Ellipse.Effect><DropShadowEffect Color="#E5A72B" BlurRadius="8" ShadowDepth="0" Opacity="0.75"/></Ellipse.Effect>
                            </Ellipse>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="WORKSHOP READY" Foreground="#E5A72B" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Local project connected" Foreground="#B8A789" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Lever-driven navigation -->
            <Border Grid.Row="1" Grid.Column="0" Background="#151411" BorderBrush="#7A5427" BorderThickness="0,0,3,0">
                <DockPanel>
                    <StackPanel x:Name="SidebarDecoration" DockPanel.Dock="Bottom" Margin="20,8,20,14">
                        <Image x:Name="VentImage" Width="164" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.9"/>
                        <Grid Margin="0,9,0,0">
                            <Image x:Name="ProjectLabelImage" Height="58" Stretch="Fill" Opacity="0.92"/>
                            <TextBlock x:Name="SidebarInfo" Foreground="#30291F" FontSize="10" FontWeight="SemiBold"
                                       TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="18,8"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Margin="14,18,14,0">
                        <TextBlock Text="SELECT STATION" Foreground="#B78332" FontSize="11" FontWeight="Bold" Margin="8,0,0,10"/>
                        <Button x:Name="PlayNavButton" AutomationProperties.Name="Play and Test station" Style="{DynamicResource NavButton}" Margin="0,0,0,8" Height="82">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image x:Name="PlayLever" Width="68" Height="68" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="PLAY &amp; TEST" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Launch experiences" Foreground="#A89573" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="FigmaNavButton" AutomationProperties.Name="Figma Design station" Style="{DynamicResource NavButton}" Margin="0,0,0,8" Height="82">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image x:Name="FigmaLever" Width="68" Height="68" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="FIGMA DESIGN" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Apply visual edits" Foreground="#A89573" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="ToolsNavButton" AutomationProperties.Name="Build and Tools station" Style="{DynamicResource NavButton}" Height="82">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Image x:Name="ToolsLever" Width="68" Height="68" Stretch="Uniform"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="BUILD &amp; TOOLS" FontSize="15" FontWeight="Bold"/>
                                    <TextBlock Text="Check and package" Foreground="#A89573" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main station canvas -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="40,24,38,24">
                    <Image x:Name="PanelCornerImage" HorizontalAlignment="Right" VerticalAlignment="Top" Width="165" Height="84" Opacity="0.62" IsHitTestVisible="False"/>

                    <Grid x:Name="PlayPage">
                        <Image x:Name="BlueprintImage" HorizontalAlignment="Right" VerticalAlignment="Center" Width="330" Height="430"
                               Stretch="Uniform" Opacity="0.28" IsHitTestVisible="False" Margin="0,20,6,0"/>
                        <StackPanel Width="650" HorizontalAlignment="Left">
                            <TextBlock Text="Launch Bay" Foreground="#F2E7CE" FontSize="42" FontWeight="Bold"/>
                            <Border Height="2" Background="#8A622E" Margin="0,8,0,18"/>
                            <TextBlock Text="ACTIVE PRESET" Foreground="#D2A74D" FontSize="12" FontWeight="Bold"/>
                            <ComboBox x:Name="RecipeBox" Width="430" HorizontalAlignment="Left" Margin="0,7,0,0"/>

                            <Button x:Name="PlayableButton" Style="{DynamicResource PrimaryButton}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="OPEN SHARED TEST EXPERIENCE" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="Uses the selected preset with real saved test data." Foreground="#DCE9E4" FontSize="12" FontWeight="Normal" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="TemplateButton" Grid.Column="0" Style="{DynamicResource SecondaryButton}">
                                    <StackPanel><TextBlock Text="OPEN TEMPLATE WORKBENCH" FontSize="13" FontWeight="Bold"/><TextBlock Text="Safe mock data for UI authoring." Foreground="#B8A789" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                </Button>
                                <Button x:Name="DesignerButton" Grid.Column="2" Style="{DynamicResource SecondaryButton}">
                                    <StackPanel><TextBlock Text="OPEN GAME DESIGNER" FontSize="13" FontWeight="Bold"/><TextBlock Text="Choose packs, currencies, and systems." Foreground="#B8A789" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                </Button>
                            </Grid>

                            <Border Background="#191713" BorderBrush="#715025" BorderThickness="1" Padding="13" Margin="0,14,0,0">
                                <TextBlock Foreground="#CBB891" FontSize="12" TextWrapping="Wrap"
                                           Text="The shared test experience stores real progress. The Template Workbench always uses safe mock data and cannot alter player saves."/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="FigmaPage" Visibility="Collapsed">
                        <TextBlock Text="Figma Design" Foreground="#F2E7CE" FontSize="42" FontWeight="Bold"/>
                        <Border Height="2" Background="#8A622E" Margin="0,8,0,18"/>
                        <TextBlock Text="Apply a visual patch to one independent UI pack. Other packs remain untouched."
                                   Foreground="#CBB891" FontSize="13" TextWrapping="Wrap"/>
                        <Border Background="#181713" BorderBrush="#8A622E" BorderThickness="2" Padding="18" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="TARGET UI PACK" Foreground="#D2A74D" FontSize="12" FontWeight="Bold"/>
                                <ComboBox x:Name="FigmaPresetBox" Width="430" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                <TextBlock Text="FIGMA PATCH FILE" Foreground="#D2A74D" FontSize="12" FontWeight="Bold" Margin="0,15,0,0"/>
                                <Grid Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="PatchBox" Height="40"/>
                                    <Button x:Name="RescanButton" Grid.Column="2" Style="{DynamicResource SmallButton}" Content="Newest export"/>
                                    <Button x:Name="BrowseButton" Grid.Column="4" Style="{DynamicResource SmallButton}" Content="Browse..."/>
                                </Grid>
                                <TextBlock x:Name="PatchHint" Foreground="#A89573" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                <Button x:Name="ApplyFigmaButton" Style="{DynamicResource PrimaryButton}" Margin="0,15,0,0">
                                    <StackPanel><TextBlock Text="APPLY FIGMA DESIGN" FontSize="17" FontWeight="Bold"/><TextBlock Text="Validates every mapped layer before updating the selected pack." Foreground="#DCE9E4" FontSize="12" FontWeight="Normal" Margin="0,5,0,0"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ToolsPage" Visibility="Collapsed">
                        <TextBlock Text="Build &amp; Tools" Foreground="#F2E7CE" FontSize="42" FontWeight="Bold"/>
                        <Border Height="2" Background="#8A622E" Margin="0,8,0,18"/>
                        <TextBlock Text="Run project maintenance without remembering PowerShell commands. Results appear in the Workshop Log."
                                   Foreground="#CBB891" FontSize="13" TextWrapping="Wrap"/>
                        <Border Background="#181713" BorderBrush="#8A622E" BorderThickness="2" Padding="18" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="PROJECT HEALTH" Foreground="#D2A74D" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Formatting, linting, builds, tests, and tool setup." Foreground="#A89573" FontSize="12" Margin="0,5,0,12"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="RunChecksButton" Style="{DynamicResource SecondaryButton}" Content="RUN FULL PROJECT CHECKS"/>
                                    <Button x:Name="RepairSetupButton" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Content="REPAIR / INSTALL SETUP"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#181713" BorderBrush="#8A622E" BorderThickness="2" Padding="18" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="UI PACKAGES &amp; ASSETS" Foreground="#D2A74D" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="Build drag-and-drop packages or manage the shared icon library." Foreground="#A89573" FontSize="12" Margin="0,5,0,12"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="BuildPackButton" Style="{DynamicResource SmallButton}" Content="Build UI packages"/>
                                    <Button x:Name="OpenExportsButton" Grid.Column="2" Style="{DynamicResource SmallButton}" Content="Open exports"/>
                                    <Button x:Name="IconsButton" Grid.Column="4" Style="{DynamicResource SmallButton}" Content="Icon library"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Workshop log is intentionally visible: no hidden console window required. -->
            <Border x:Name="OutputPanel" Grid.Row="2" Grid.ColumnSpan="2" Background="#0B0B09" BorderBrush="#8A622E" BorderThickness="0,3,0,2" Padding="20,10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#B77A2A" BorderBrush="#E2BA68" BorderThickness="1" Padding="12,4">
                            <TextBlock Text="WORKSHOP LOG" Foreground="#171512" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Border Grid.Column="1" Height="1" Background="#6C4A22" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11" Background="#080807"
                             BorderBrush="#3E2C17" Foreground="#72B7AE" Padding="10,7"
                             Text="[ready] Workshop is idle. Choose a station or launch a task."/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#171512" BorderBrush="#6C4A22" BorderThickness="0,1,0,0" Padding="18,7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="StopTaskButton" Style="{DynamicResource SmallButton}" Content="STOP TASK" Visibility="Collapsed" Margin="0,0,8,0"/>
                        <Button x:Name="OutputToggle" Style="{DynamicResource SmallButton}" Content="Hide workshop log"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="11" Height="11" Fill="#E5A72B" Stroke="#D2A74D" StrokeThickness="1" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ActivityStatus" Foreground="#D9C49C" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Text="Ready."/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
