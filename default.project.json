{
  "name": "RobloxPlayableStarter",
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "Template": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/shared"
        }
      }
    },
    "ServerScriptService": {
      "TemplateServer": {
        "$path": "src/server"
      },
      "PlayableStarter": {
        "$path": "src/starter"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "Sensor"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "TemplateClient": {
          "$path": "src/client"
        },
        "PlayableStarterClient": {
          "$path": "src/starter-client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "TemplateSpawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Neutral": true,
          "Position": [0, 3, 0],
          "Size": [12, 1, 12]
        }
      },
      "GalleryFloor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Position": [0, 0, 0],
          "Size": [128, 1, 128],
          "Color": [0.08, 0.09, 0.14],
          "Material": "SmoothPlastic"
        }
      },
      "ExampleEarningPad": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Color": [0.3137255, 0.5294118, 1],
          "Material": "Neon",
          "Position": [0, 1, -18],
          "Size": [12, 1, 12]
        },
        "EarnPrompt": {
          "$className": "ProximityPrompt",
          "$properties": {
            "ActionText": "Earn 10 Coins",
            "ObjectText": "Coin Trainer",
            "HoldDuration": 0.25,
            "MaxActivationDistance": 12,
            "RequiresLineOfSight": false
          }
        }
      },
      "BonusEarningPad": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Color": [0.0196078, 0.8196078, 0.7019608],
          "Material": "Neon",
          "Position": [18, 1, -18],
          "Size": [12, 1, 12]
        },
        "BonusPrompt": {
          "$className": "ProximityPrompt",
          "$properties": {
            "ActionText": "Earn Bonus Currency",
            "ObjectText": "Bonus Trainer",
            "HoldDuration": 0.25,
            "MaxActivationDistance": 12,
            "RequiresLineOfSight": false
          }
        }
      }
    },
    "TextChatService": {
      "$properties": {
        "CreateDefaultCommands": true,
        "CreateDefaultTextChannels": true
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": false
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
