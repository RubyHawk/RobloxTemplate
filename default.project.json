{
  "name": "RobloxTemplateGallery",
  "emitLegacyScripts": true,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$path": "src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "Template": {
        "$className": "Folder",
        "DungeonWeapons": {
          "$path": "src/assets/DungeonWeapons.model.json"
        },
        "Shared": {
          "$path": "src/shared"
        },
        "EnemyRigs": {
          "$path": "src/world/EnemyRigs.model.json"
        }
      }
    },
    "ServerScriptService": {
      "TemplateServer": {
        "$path": "src/server"
      },
      "PlayableStarter": {
        "$path": "src/starter"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "Sensor"
      },
      "RuneCircleSign": {
        "$path": "src/ui/RuneCircleSign.model.json"
      },
      "RuneCircleUI": {
        "$path": "src/ui/RuneCircleUI.model.json"
      },
      "StagePlatformOwners": {
        "$path": "src/ui/StagePlatformOwners.model.json"
      },
      "StagewrightPlaytestHUD": {
        "$path": "src/ui/StagewrightPlaytestHUD.model.json"
      },
      "TowerDefenseTravelHUD": {
        "$path": "src/ui/TowerDefenseTravelHUD.model.json"
      },
      "PortalSign": {
        "$path": "src/ui/PortalSign.model.json"
      },
      "DungeonHUD": {
        "$path": "src/ui/DungeonHUD.model.json"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "TemplateClient": {
          "$path": "src/client"
        },
        "PlayableStarterClient": {
          "$path": "src/starter-client"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      },
      "TemplateSpawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Neutral": true,
          "Position": [0, 3, 0],
          "Size": [12, 1, 12]
        }
      },
      "GalleryFloor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Position": [0, 0, 0],
          "Size": [128, 1, 128],
          "Color": [0.08, 0.09, 0.14],
          "Material": "SmoothPlastic"
        }
      },
      "ExampleEarningPad": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Color": [0.3137255, 0.5294118, 1],
          "Material": "Neon",
          "Position": [0, 1, -18],
          "Size": [12, 1, 12]
        },
        "EarnPrompt": {
          "$className": "ProximityPrompt",
          "$properties": {
            "ActionText": "Earn 10 Coins",
            "ObjectText": "Coin Trainer",
            "HoldDuration": 0.25,
            "MaxActivationDistance": 12,
            "RequiresLineOfSight": false
          }
        }
      },
      "BonusEarningPad": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "CanCollide": true,
          "Color": [0.0196078, 0.8196078, 0.7019608],
          "Material": "Neon",
          "Position": [18, 1, -18],
          "Size": [12, 1, 12]
        },
        "BonusPrompt": {
          "$className": "ProximityPrompt",
          "$properties": {
            "ActionText": "Earn Bonus Currency",
            "ObjectText": "Bonus Trainer",
            "HoldDuration": 0.25,
            "MaxActivationDistance": 12,
            "RequiresLineOfSight": false
          }
        }
      },
      "RuneCircle": {
        "$className": "Model",
        "Platform": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": true,
            "CastShadow": false,
            "Color": [0.129411, 0.086274, 0.219607],
            "Material": "SmoothPlastic",
            "Orientation": [0, 0, 90],
            "Position": [-18, 0.9, -18],
            "Shape": "Cylinder",
            "Size": [0.6, 14, 14]
          }
        },
        "GlowRing": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "CanQuery": false,
            "CanTouch": false,
            "CastShadow": false,
            "Color": [0.549019, 0.360784, 0.960784],
            "Material": "Neon",
            "Orientation": [0, 0, 90],
            "Position": [-18, 0.72, -18],
            "Shape": "Cylinder",
            "Size": [0.3, 16.6, 16.6],
            "Transparency": 0.1
          }
        },
        "CoreGlow": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "CanQuery": false,
            "CanTouch": false,
            "CastShadow": false,
            "Color": [0.721568, 0.549019, 1],
            "Material": "Neon",
            "Orientation": [0, 0, 90],
            "Position": [-18, 0.94, -18],
            "Shape": "Cylinder",
            "Size": [0.62, 7, 7],
            "Transparency": 0.25
          },
          "RuneLight": {
            "$className": "PointLight",
            "$properties": {
              "Brightness": 2.5,
              "Color": [0.619607, 0.419607, 1],
              "Range": 20,
              "Shadows": false
            }
          }
        },
        "Shard1": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "CanQuery": false,
            "CanTouch": false,
            "CastShadow": false,
            "Color": [0.898039, 0.619607, 1],
            "Material": "Neon",
            "Orientation": [0, 0, 12],
            "Position": [-12.5, 3.2, -18],
            "Size": [0.9, 1.5, 0.4]
          }
        },
        "Shard2": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "CanQuery": false,
            "CanTouch": false,
            "CastShadow": false,
            "Color": [0.898039, 0.619607, 1],
            "Material": "Neon",
            "Orientation": [0, 120, -8],
            "Position": [-20.75, 3.2, -13.24],
            "Size": [0.9, 1.5, 0.4]
          }
        },
        "Shard3": {
          "$className": "Part",
          "$properties": {
            "Anchored": true,
            "CanCollide": false,
            "CanQuery": false,
            "CanTouch": false,
            "CastShadow": false,
            "Color": [0.898039, 0.619607, 1],
            "Material": "Neon",
            "Orientation": [0, 240, 10],
            "Position": [-20.75, 3.2, -22.76],
            "Size": [0.9, 1.5, 0.4]
          }
        }
      },
      "FirstPrivateIsland": {
        "$path": "src/world/FirstPrivateIslandGridDemo.model.json"
      },
      "PortalPad": {
        "$path": "src/world/PortalPad.model.json"
      },
      "DungeonArena": {
        "$path": "src/world/DungeonArena.model.json"
      }
    },
    "TextChatService": {
      "$properties": {
        "CreateDefaultCommands": true,
        "CreateDefaultTextChannels": true
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": false
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
