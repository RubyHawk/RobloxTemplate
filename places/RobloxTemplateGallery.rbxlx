        <string name="Name">GalleryMenu</string>
        <bool name="ClipToDeviceSafeArea">true</bool>
        <int name="DisplayOrder">200</int>
        <bool name="Enabled">false</bool>
        <bool name="ResetOnSpawn">false</bool>
        <token name="SafeAreaCompatibility">0</token>
        <token name="ScreenInsets">2</token>
        <token name="ZIndexBehavior">1</token>
      </Properties>
      <Item class="Frame" referent="68">
        <Properties>
          <string name="Name">Root</string>
          <float name="BackgroundTransparency">1</float>
          <int name="BorderSizePixel">0</int>
          <UDim2 name="Size">
            <XS>1</XS>
            <XO>0</XO>
            <YS>1</YS>
            <YO>0</YO>
          </UDim2>
        </Properties>
        <Item class="Frame" referent="69">
          <Properties>
            <string name="Name">Toolbar</string>
            <Vector2 name="AnchorPoint">
              <X>0.5</X>
              <Y>0</Y>
            </Vector2>
            <Color3 name="BackgroundColor3">
              <R>0.0470588</R>
              <G>0.0588235</G>
              <B>0.1058824</B>
            </Color3>
            <int name="BorderSizePixel">0</int>
            <UDim2 name="Position">
              <XS>0.5</XS>
              <XO>0</XO>
              <YS>0</YS>
              <YO>12</YO>
            </UDim2>
            <UDim2 name="Size">
