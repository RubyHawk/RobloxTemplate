  </Item>
  <Item class="SoundService" referent="45">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterGui" referent="46">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="47">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="48">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="49">
        <Properties>
          <string name="Name">TemplateClient</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Template"):WaitForChild("Shared")
local IconCatalog = require(Shared.IconCatalog)
local RemoteNames = require(Shared.RemoteNames)
local Theme = require(Shared.Theme)

type IconName = IconCatalog.IconName

local Controllers = script.Controllers
local AudioController = require(Controllers.AudioController)
local AfkController = require(Controllers.AfkController)
local NotificationController = require(Controllers.NotificationController)
local UIFactory = require(script.UI.UIFactory)
local ScreenRegistry = require(script.UI.ScreenRegistry)
local Screens = require(script.UI.Screens)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild(RemoteNames.folder)
local requestRemote = remotes:WaitForChild(RemoteNames.request) :: RemoteEvent
local stateRemote = remotes:WaitForChild(RemoteNames.state) :: RemoteEvent
local queryRemote = remotes:WaitForChild(RemoteNames.query) :: RemoteFunction

task.spawn(function()
	for _ = 1, 10 do
		local success = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if success then
			break
		end
		task.wait(0.25)
	end
end)

local playerGui = player:WaitForChild("PlayerGui")
local screenGui = playerGui:WaitForChild("TemplateUI") :: ScreenGui
assert(screenGui:IsA("ScreenGui"), "StarterGui.TemplateUI must be a ScreenGui")
screenGui.Enabled = true

local root = screenGui:WaitForChild("Root") :: Frame
local uiScale = root:WaitForChild("InterfaceScale") :: UIScale
local hud = root:WaitForChild("CurrencyHUD") :: Frame
local coinLabel = hud:WaitForChild("CoinLabel") :: TextLabel
local boostLabel = hud:WaitForChild("BoostLabel") :: TextLabel
local addCoinsButton = hud:WaitForChild("AddCoinsButton") :: TextButton
local nav = root:WaitForChild("Navigation") :: Frame
local navScroll = nav:WaitForChild("Buttons") :: ScrollingFrame
local moreMenu = root:WaitForChild("MoreMenu") :: Frame
local moreMenuButtons = moreMenu:WaitForChild("Buttons") :: ScrollingFrame
local moreCloseButton = moreMenu:WaitForChild("CloseButton") :: TextButton
local screensLayer = root:WaitForChild("Screens") :: Frame
local toast = root:WaitForChild("Toast") :: Frame
local toastLabel = toast:WaitForChild("Message") :: TextLabel
local toastToken = 0

local function applyIcon(container: Instance, name: IconName, imageName: string, fallbackName: string?)
	local image = container:FindFirstChild(imageName)
	if not image or not image:IsA("ImageLabel") then
		return
	end
	local content = IconCatalog.get(name)
	if content == "" then
		return
	end
	image.Image = content
	image.Visible = true
	if fallbackName then
		local fallback = container:FindFirstChild(fallbackName)
		if fallback and fallback:IsA("GuiObject") then
			fallback.Visible = false
		end
	end
end

applyIcon(hud:WaitForChild("CoinBadge"), "coin", "Icon", "Symbol")
applyIcon(toast:WaitForChild("IconBadge"), "notifications", "Icon", "Symbol")
applyIcon(moreCloseButton, "close", "Icon", nil)
if IconCatalog.get("close") ~= "" then
	moreCloseButton.Text = ""
end

local function tweenInfo(duration: number, easingStyle: Enum.EasingStyle?): TweenInfo
	local adjustedDuration = if GuiService.ReducedMotionEnabled then 0 else duration
	return if easingStyle
		then TweenInfo.new(adjustedDuration, easingStyle)
		else TweenInfo.new(adjustedDuration)
end

local function showToast(message: string)
	toastToken += 1
	local token = toastToken
	toastLabel.Text = message
	TweenService:Create(toast, tweenInfo(0.2, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 12) })
		:Play()
	task.delay(3.5, function()
		if token == toastToken then
			TweenService:Create(toast, tweenInfo(0.2), { Position = UDim2.new(0.5, 0, 0, -180) }):Play()
		end
	end)
end

AudioController.initialize()

local function optionalScreenGui(name: string): ScreenGui?
	local candidate = playerGui:FindFirstChild(name)
	return if candidate and candidate:IsA("ScreenGui") then candidate else nil
end

local function setupGalleryMenu()
	local galleryMenu = optionalScreenGui("GalleryMenu")
	if not galleryMenu then
		return
	end
	galleryMenu.Enabled = true

	local packShowroom = optionalScreenGui("ZxglyV5Showroom")
	local notificationShowroom = optionalScreenGui("NotificationV2Showroom")
	local backdrop = optionalScreenGui("GalleryBackdrop")
	local menuRoot = galleryMenu:WaitForChild("Root") :: Frame
	local toolbar = menuRoot:WaitForChild("Toolbar") :: Frame
	local modesFrame = toolbar:WaitForChild("Modes") :: Frame
	local modeCard = menuRoot:WaitForChild("ModeCard") :: Frame
	local description = modeCard:WaitForChild("Description") :: TextLabel

	local modes = {
		{
			name = "Connected",
			buttonName = "ConnectedButton",
			description = "Connected UI: the real HUD and systems. Use this to test the starter experience.",
			heading = "CONNECTED TEMPLATE UI",
			detail = "The real inventory, store, rewards, profiles, settings, and HUD.",
		},
		{
			name = "Pack",
			buttonName = "PackButton",
			description = "UI Pack: a script-free component sheet. Edit ZxglyV5Showroom under StarterGui.",
			heading = "VISUAL UI PACK",
			detail = "Script-free reference screens arranged as one isolated component sheet.",
		},
		{
			name = "Notification",
			buttonName = "NotificationButton",
			description = "Notification: one isolated visual preview. Runtime messages still use secure template logic.",
			heading = "NOTIFICATION PREVIEW",
			detail = "Visual reference only; supplied third-party scripts were intentionally removed.",
		},
	}

	local buttons: { [string]: TextButton } = {}
	local function setMode(modeName: string)
		screenGui.Enabled = modeName == "Connected"
		if packShowroom then
			packShowroom.Enabled = modeName == "Pack"
		end
		if notificationShowroom then
			notificationShowroom.Enabled = modeName == "Notification"
		end
		if backdrop then
			backdrop.Enabled = modeName ~= "Connected"
		end

		for _, mode in modes do
			local selected = mode.name == modeName
			buttons[mode.name].BackgroundColor3 = if selected
				then Theme.colors.primary
				else Theme.colors.surfaceRaised
			if selected then
				description.Text = mode.description
				if backdrop then
					local background = backdrop:WaitForChild("Background") :: Frame
					local heading = background:WaitForChild("Heading") :: TextLabel
					local detail = background:WaitForChild("Detail") :: TextLabel
					heading.Text = mode.heading
					detail.Text = mode.detail
				end
			end
		end
	end

	for _, mode in modes do
		local button = modesFrame:WaitForChild(mode.buttonName) :: TextButton
		local modeName = mode.name
		buttons[modeName] = button
		button.Activated:Connect(function()
			AudioController.play("click")
			setMode(modeName)
		end)
	end

	setMode("Connected")
end

setupGalleryMenu()
local registry = ScreenRegistry.new()
local state: any = nil

local function request(action: string, payload: any)
	AudioController.play("click")
	requestRemote:FireServer({ action = action, payload = payload })
end

local function query(action: string, payload: any): any
	local success, response = pcall(function()
		return queryRemote:InvokeServer(action, payload)
	end)
	return if success then response else { ok = false, message = "Server request failed" }
end

local binder = Screens.bind(screensLayer, {
	request = request,
	query = query,
	close = function()
		registry:close()
	end,
	open = function(name: string)
		registry:open(name)
	end,
	toast = showToast,
	promptNotifications = function()
		task.spawn(function()
			local _, message = NotificationController.prompt()
			showToast(message)
		end)
	end,
	promptProduct = function(productName: string)
		if not state then
			return
		end
		local productId = state.productIds[productName]
		if type(productId) == "number" and productId > 0 then
			MarketplaceService:PromptProductPurchase(player, productId)
		else
			showToast("Product is not configured")
		end
	end,
	promptExtendedOffline = function()
		if not state then
			return
		end
		local passId = state.productIds.extendedOffline
		if type(passId) == "number" and passId > 0 then
			MarketplaceService:PromptGamePassPurchase(player, passId)
		else
			showToast("Game pass is not configured")
		end
	end,
	promptPremium = function()
		MarketplaceService:PromptPremiumPurchase(player)
	end,
})

for name, screen in binder.screens do
	registry:register(name, screen)
end

local navItems = {
	{ "BagButton", "Inventory", "bag" },
	{ "ShopButton", "Store", "shop" },
	{ "GiftButton", "Rewards", "rewards" },
	{ "ProfileButton", "Profile", "profile" },
}
for _, item in navItems do
	local button = navScroll:WaitForChild(item[1]) :: TextButton
	local screenName = item[2]
	local iconName = item[3] :: IconName
	applyIcon(button:WaitForChild("IconBubble"), iconName, "PackIcon", "Icon")
	local restingColor = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = Theme.colors.surfaceRaised }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = restingColor }):Play()
	end)
	button.Activated:Connect(function()
		AudioController.play("click")
		moreMenu.Visible = false
		if registry.current == screenName then
			registry:close()
		else
			registry:open(screenName)
		end
	end)
end

local moreButton = navScroll:WaitForChild("MoreButton") :: TextButton
applyIcon(moreButton:WaitForChild("IconBubble"), "more", "PackIcon", "Icon")
local moreButtonRestingColor = moreButton.BackgroundColor3
moreButton.MouseEnter:Connect(function()
	TweenService:Create(moreButton, tweenInfo(0.12), { BackgroundColor3 = Theme.colors.surfaceRaised }):Play()
end)
moreButton.MouseLeave:Connect(function()
	TweenService:Create(moreButton, tweenInfo(0.12), { BackgroundColor3 = moreButtonRestingColor }):Play()
end)
moreButton.Activated:Connect(function()
	AudioController.play("click")
	registry:close()
	moreMenu.Visible = not moreMenu.Visible
end)

moreCloseButton.Activated:Connect(function()
	AudioController.play("click")
	moreMenu.Visible = false
end)

addCoinsButton.Activated:Connect(function()
	AudioController.play("click")
	moreMenu.Visible = false
	if registry.current == "Store" then
		registry:close()
	else
		registry:open("Store")
	end
end)

local moreItems = {
	{ "CodesButton", "Codes", "codes" },
	{ "BoardsButton", "Boards", "leaderboard" },
	{ "CommunityButton", "Community", "community" },
	{ "FeedbackButton", "Feedback", "feedback" },
	{ "SettingsButton", "Settings", "settings" },
}
for _, item in moreItems do
	local button = moreMenuButtons:WaitForChild(item[1]) :: TextButton
	local screenName = item[2]
	local iconName = item[3] :: IconName
	applyIcon(button, iconName, "Icon", "Fallback")
	local restingColor = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = Theme.colors.surfaceRaised }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = restingColor }):Play()
	end)
	button.Activated:Connect(function()
		AudioController.play("click")
		moreMenu.Visible = false
		registry:open(screenName)
	end)
end

local function applyState(nextState: any)
	if nextState == nil or nextState.profile == nil then
		return
	end
	local previousCoins = if state and state.profile then state.profile.coins else nextState.profile.coins
	state = nextState
	coinLabel.Text = UIFactory.formatNumber(state.profile.coins)
	boostLabel.Text = `x{string.format(
		"%.2f",
		(1 + state.friendBonus + state.premiumBonus) * state.potionMultiplier
	)} BOOST  •  {state.profile.social.friendCountInServer} FRIENDS`
	uiScale.Scale = state.profile.settings.uiScale
	AudioController.applySettings(state.profile.settings)
	if state.profile.coins > previousCoins then
		AudioController.play("cash")
	end
	AfkController.setEnabled(state.profile.settings.afKRollOver)
	binder.apply(state)
end

stateRemote.OnClientEvent:Connect(function(packet)
	if type(packet) ~= "table" then
		return
	end
	if packet.kind == "Snapshot" then
		applyState(packet.data)
	elseif packet.kind == "Result" then
		showToast(packet.message or if packet.ok then "Done" else "Request failed")
		if packet.ok then
			AudioController.play("reward")
		end
	elseif packet.kind == "Announcement" and state and state.profile.settings.announcements then
		showToast(packet.message)
		local channels = TextChatService:FindFirstChild("TextChannels")
		local systemChannel = if channels then channels:FindFirstChild("RBXSystem") else nil
		if systemChannel and systemChannel:IsA("TextChannel") then
			systemChannel:DisplaySystemMessage(`[SYSTEM] {packet.message}`)
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Escape) then
		if moreMenu.Visible then
			moreMenu.Visible = false
		else
			registry:close()
		end
	end
end)

AfkController.initialize(function()
	request("AfkRollover", {})
end, showToast)

task.spawn(function()
	for _ = 1, 30 do
		local response = query("InitialState", {})
		if response.ok and response.data then
			applyState(response.data)
			return
		end
		task.wait(1)
	end
	showToast("Profile did not load. Rejoin to retry.")
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="50">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">AfkController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Config = require(
	game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").TemplateConfig
)

local AfkController = {}
local enabled = true
local countdownToken = 0

function AfkController.setEnabled(value: boolean)
	enabled = value
	if not enabled then
		countdownToken += 1
	end
end

function AfkController.initialize(requestRollOver: () -> (), notify: (string) -> ())
	UserInputService.InputBegan:Connect(function()
		countdownToken += 1
	end)

	Players.LocalPlayer.Idled:Connect(function(idleSeconds)
		if not enabled or idleSeconds < Config.afK.warnAfterIdleSeconds then
			return
		end
		countdownToken += 1
		local token = countdownToken
		notify(`AFK: moving to a fresh server in {Config.afK.countdownSeconds}s. Press any input to cancel.`)
		task.delay(Config.afK.countdownSeconds, function()
			if enabled and token == countdownToken then
				requestRollOver()
			end
		end)
	end)
end

return AfkController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict

local SoundService = game:GetService("SoundService")

local Config = require(
	game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").TemplateConfig
)

local AudioController = {}
local sounds: { [string]: Sound } = {}
local musicGroup: SoundGroup
local sfxGroup: SoundGroup

local function group(name: string): SoundGroup
	local existing = SoundService:FindFirstChild(name)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local created = Instance.new("SoundGroup")
	created.Name = name
	created.Parent = SoundService
	return created
end

function AudioController.initialize()
	musicGroup = group("TemplateMusic")
	sfxGroup = group("TemplateSFX")
	for name, assetId in Config.audio do
		if assetId ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = assetId
			sound.SoundGroup = if name == "music" then musicGroup else sfxGroup
			sound.Looped = name == "music"
			sound.Parent = SoundService
			sounds[name] = sound
		end
	end
	if sounds.music then
		sounds.music:Play()
	end
end

function AudioController.applySettings(settings: any)
	if musicGroup then
		musicGroup.Volume = math.clamp(settings.musicVolume or 0.5, 0, 1)
	end
	if sfxGroup then
		sfxGroup.Volume = math.clamp(settings.sfxVolume or 0.7, 0, 1)
	end
end

function AudioController.play(name: string)
	local sound = sounds[name]
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--!strict

local ExperienceNotificationService = game:GetService("ExperienceNotificationService")

local NotificationController = {}

function NotificationController.prompt(): (boolean, string)
	local success, canPrompt = pcall(function()
		return ExperienceNotificationService:CanPromptOptInAsync()
	end)
	if not success then
		return false, "Notification eligibility could not be checked"
	end
	if not canPrompt then
		return false, "Roblox notifications are already configured or unavailable for this account"
	end
	local promptSuccess = pcall(function()
		ExperienceNotificationService:PromptOptIn()
	end)
	return promptSuccess,
		if promptSuccess then "Roblox opened the notification prompt" else "Notification prompt failed"
end

return NotificationController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ScreenRegistry</string>
              <string name="Source"><![CDATA[--!strict

local ScreenRegistry = {}
ScreenRegistry.__index = ScreenRegistry

export type ScreenRegistry = typeof(setmetatable(
	{} :: {
		screens: { [string]: GuiObject },
		current: string?,
	},
	ScreenRegistry
))

function ScreenRegistry.new(): ScreenRegistry
	return setmetatable({ screens = {}, current = nil }, ScreenRegistry)
end

function ScreenRegistry.register(self: ScreenRegistry, name: string, screen: GuiObject)
	self.screens[name] = screen
	screen.Visible = false
end

function ScreenRegistry.open(self: ScreenRegistry, name: string)
	for screenName, screen in self.screens do
		screen.Visible = screenName == name
	end
	self.current = name
end

function ScreenRegistry.close(self: ScreenRegistry)
	for _, screen in self.screens do
		screen.Visible = false
	end
	self.current = nil
end

return ScreenRegistry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local IconCatalog = require(Shared.IconCatalog)
local Theme = require(Shared.Theme)
local UIFactory = require(script.Parent.UIFactory)

type IconName = IconCatalog.IconName

local INVENTORY_SLOT_COUNT = 12
local STORE_SLOT_COUNT = 8
local SERVER_ROW_COUNT = 10
local GLOBAL_ROW_COUNT = 50

local Screens = {}

local function frame(parent: Instance, name: string): Frame
	local value = parent:WaitForChild(name)
	assert(value:IsA("Frame"), `{value:GetFullName()} must be a Frame`)
	return value
end

local function textButton(parent: Instance, name: string): TextButton
	local value = parent:WaitForChild(name)
	assert(value:IsA("TextButton"), `{value:GetFullName()} must be a TextButton`)
	return value
end

local function textLabel(parent: Instance, name: string): TextLabel
	local value = parent:WaitForChild(name)
	assert(value:IsA("TextLabel"), `{value:GetFullName()} must be a TextLabel`)
	return value
end

local function textBox(parent: Instance, name: string): TextBox
	local value = parent:WaitForChild(name)
	assert(value:IsA("TextBox"), `{value:GetFullName()} must be a TextBox`)
	return value
end

local function content(screen: Frame): ScrollingFrame
	local value = screen:WaitForChild("Content")
	assert(value:IsA("ScrollingFrame"), `{value:GetFullName()} must be a ScrollingFrame`)
	return value
end

local function numberedFrames(parent: Instance, prefix: string, count: number): { Frame }
	local values = {}
	for index = 1, count do
		table.insert(values, frame(parent, `{prefix}{string.format("%02d", index)}`))
	end
	return values
end

local function applyIcon(container: Instance, name: IconName)
	local icon = container:FindFirstChild("Icon")
	if not icon or not icon:IsA("ImageLabel") then
		return
	end
	local fallback = container:FindFirstChild("Symbol") or container:FindFirstChild("Fallback")
	local image = IconCatalog.get(name)
	icon.Image = image
	icon.Visible = image ~= ""
	if fallback and fallback:IsA("GuiObject") then
		fallback.Visible = image == ""
	end
end

local function setRow(card: Frame, title: string, body: string, iconName: IconName?)
	textLabel(card, "Title").Text = title
	textLabel(card, "Body").Text = body
	if iconName then
		applyIcon(frame(card, "IconBadge"), iconName)
	end
	card.Visible = true
end

local function setItemArtwork(slot: Frame, icon: string, glyphText: string)
	local artwork = frame(slot, "Artwork")
	local glyph = textLabel(artwork, "Glyph")
	local image = artwork:WaitForChild("Icon")
	assert(image:IsA("ImageLabel"), `{image:GetFullName()} must be an ImageLabel`)
	image.Image = icon
	image.Visible = icon ~= ""
	glyph.Text = glyphText
	glyph.Visible = icon == ""
end

local function setItemSlot(
	slot: Frame,
	title: string,
	body: string,
	quantityText: string,
	actionText: string,
	icon: string,
	glyph: string,
	action: string,
	value: string
)
	textLabel(slot, "Title").Text = title
	textLabel(slot, "Body").Text = body
	textLabel(slot, "Quantity").Text = quantityText
	textButton(slot, "ActionButton").Text = actionText
	setItemArtwork(slot, icon, glyph)
	slot:SetAttribute("Action", action)
	slot:SetAttribute("Value", value)
	slot.Visible = true
end

local function hideFrames(values: { Frame })
	for _, value in values do
		value.Visible = false
		value:SetAttribute("Action", nil)
		value:SetAttribute("Value", nil)
	end
end

local function sortedItemIds(catalog: { [string]: any }): { string }
	local ids = {}
	for itemId in catalog do
		table.insert(ids, itemId)
	end
	table.sort(ids, function(left, right)
		local leftDefinition = catalog[left]
		local rightDefinition = catalog[right]
		if leftDefinition.priceCoins and rightDefinition.priceCoins then
			return leftDefinition.priceCoins < rightDefinition.priceCoins
		end
		return leftDefinition.name < rightDefinition.name
	end)
	return ids
end

local function connectClose(screen: Frame, close: () -> ())
	local closeButton = textButton(screen, "CloseButton")
	applyIcon(closeButton, "close")
	if IconCatalog.get("close") ~= "" then
		closeButton.Text = ""
	end
	closeButton.Activated:Connect(close)
end

function Screens.bind(parent: Instance, context: any): any
	local screenMap: { [string]: Frame } = {
		Inventory = frame(parent, "InventoryScreen"),
		Store = frame(parent, "StoreScreen"),
		Rewards = frame(parent, "RewardsScreen"),
		Profile = frame(parent, "ProfileScreen"),
		Settings = frame(parent, "SettingsScreen"),
		Feedback = frame(parent, "FeedbackScreen"),
		Codes = frame(parent, "CodesScreen"),
		Boards = frame(parent, "BoardsScreen"),
		Community = frame(parent, "CommunityScreen"),
		Dynamic = frame(parent, "DynamicScreen"),
	}

	for _, screen in screenMap do
		connectClose(screen, context.close)
	end

	local state: any = nil
	local inventoryContent = content(screenMap.Inventory)
	local inventorySlots = numberedFrames(inventoryContent, "ItemSlot", INVENTORY_SLOT_COUNT)
	local inventoryEmpty = frame(inventoryContent, "EmptyState")
	local inventoryToolbar = frame(inventoryContent, "Toolbar")
	local inventorySearch = textBox(inventoryToolbar, "SearchInput")
	local inventoryCategory = textButton(inventoryToolbar, "CategoryButton")
	local categories = { "All", "Consumable", "Equipment", "Misc" }
	local categoryIndex = 1

	local storeContent = content(screenMap.Store)
	local storeSlots = numberedFrames(storeContent, "StoreSlot", STORE_SLOT_COUNT)
	local rewardsContent = content(screenMap.Rewards)
	local profileContent = content(screenMap.Profile)
	local settingsContent = content(screenMap.Settings)
	local feedbackContent = content(screenMap.Feedback)
	local codesContent = content(screenMap.Codes)
	local boardsContent = content(screenMap.Boards)
	local communityContent = content(screenMap.Community)
	local dynamicContent = content(screenMap.Dynamic)
	local serverRows = numberedFrames(boardsContent, "LeaderRow", SERVER_ROW_COUNT)
	local globalRows = numberedFrames(dynamicContent, "ListRow", GLOBAL_ROW_COUNT)

	local function refreshInventory()
		hideFrames(inventorySlots)
		if not state then
			inventoryEmpty.Visible = true
			return
		end
		local search = string.lower(inventorySearch.Text)
		local category = categories[categoryIndex]
		local visibleEntries = {}
		for _, itemId in sortedItemIds(state.catalog) do
			local entry = state.profile.inventory[itemId]
			local definition = state.catalog[itemId]
			if entry and entry.quantity > 0 then
				local categoryMatches = category == "All" or definition.category == category
				local nameMatches = search == ""
					or string.find(string.lower(definition.name), search, 1, true) ~= nil
				if categoryMatches and nameMatches then
					table.insert(visibleEntries, { itemId = itemId, entry = entry, definition = definition })
				end
			end
		end

		for index, data in visibleEntries do
			local slot = inventorySlots[index]
			if not slot then
				break
			end
			local action = if data.definition.category == "Consumable" then "UseItem" else "ToggleEquip"
			local actionText = if data.definition.category == "Consumable"
				then "USE"
				else if data.entry.equipped then "UNEQUIP" else "EQUIP"
			setItemSlot(
				slot,
				data.definition.name,
				data.definition.description,
				`x{data.entry.quantity}`,
				actionText,
				data.definition.icon,
				if data.definition.boostMultiplier then `x{data.definition.boostMultiplier}` else "ITEM",
				action,
				data.itemId
			)
		end
		inventoryEmpty.Visible = #visibleEntries == 0
		if inventoryEmpty.Visible then
			setRow(inventoryEmpty, "No matching items", "Try another search or category.", "item")
		end
	end

	for _, slot in inventorySlots do
		textButton(slot, "ActionButton").Activated:Connect(function()
			local action = slot:GetAttribute("Action")
			local itemId = slot:GetAttribute("Value")
			if type(action) == "string" and type(itemId) == "string" then
				context.request(action, { itemId = itemId })
			end
		end)
	end
	inventorySearch:GetPropertyChangedSignal("Text"):Connect(refreshInventory)
	inventoryCategory.Activated:Connect(function()
		categoryIndex = (categoryIndex % #categories) + 1
		inventoryCategory.Text = string.upper(categories[categoryIndex])
		refreshInventory()
	end)

	local function refreshStore()
		hideFrames(storeSlots)
		if not state then
			return
		end
		local slotIndex = 1
		for _, itemId in sortedItemIds(state.catalog) do
			local definition = state.catalog[itemId]
			if definition.priceCoins and storeSlots[slotIndex] then
				setItemSlot(
					storeSlots[slotIndex],
					definition.name,
					definition.description,
					`{UIFactory.formatNumber(definition.priceCoins)} C`,
					"BUY",
					definition.icon,
					if definition.boostMultiplier then `x{definition.boostMultiplier}` else "ITEM",
					"BuyItem",
					itemId
				)
				slotIndex += 1
			end
		end

		local productDefinitions = {
			{ key = "coinPackSmall", title = "Small Coins Pack", body = "A quick coin top-up." },
			{ key = "coinPackLarge", title = "Large Coins Pack", body = "A larger coin top-up." },
		}
		for _, product in productDefinitions do
			if state.productAvailability[product.key] and storeSlots[slotIndex] then
				setItemSlot(
					storeSlots[slotIndex],
					product.title,
					product.body,
					"ROBUX",
					"VIEW",
					IconCatalog.get("coin"),
					"C",
					"PromptProduct",
					product.key
				)
				slotIndex += 1
			end
		end

		if storeSlots[slotIndex] then
			setItemSlot(
				storeSlots[slotIndex],
				"Roblox Premium",
				if state.profile.entitlements.premium
					then "Active: permanent +10% Coins bonus."
					else "Premium members receive a permanent +10% Coins bonus.",
				if state.profile.entitlements.premium then "ACTIVE" else "+10%",
				if state.profile.entitlements.premium then "OWNED" else "VIEW",
				IconCatalog.get("premium"),
				"P",
				if state.profile.entitlements.premium then "None" else "PromptPremium",
				"premium"
			)
		end
	end

	for _, slot in storeSlots do
		textButton(slot, "ActionButton").Activated:Connect(function()
			local action = slot:GetAttribute("Action")
			local value = slot:GetAttribute("Value")
			if action == "BuyItem" and type(value) == "string" then
				context.request("BuyItem", { itemId = value })
			elseif action == "PromptProduct" and type(value) == "string" then
				context.promptProduct(value)
			elseif action == "PromptPremium" then
				context.promptPremium()
			end
		end)
	end

	local rewardStrip = rewardsContent:WaitForChild("RewardStrip")
	local rewardTiles = {}
	for day = 1, 7 do
		table.insert(rewardTiles, frame(rewardStrip, `Day{day}`))
	end
	textButton(rewardsContent, "ClaimDailyButton").Activated:Connect(function()
		context.request("ClaimDaily", {})
	end)
	textButton(rewardsContent, "ClaimOfflineButton").Activated:Connect(function()
		context.request("ClaimOffline", {})
	end)
	textButton(rewardsContent, "ExtendedOfflineButton").Activated:Connect(context.promptExtendedOffline)

	local profileSearch = textBox(profileContent, "SearchInput")
	local profileResult = frame(profileContent, "SearchResult")
	textButton(profileContent, "SearchButton").Activated:Connect(function()
		setRow(profileResult, "Searching…", "Looking up public player stats.", "search")
		task.spawn(function()
			local response = context.query("SearchProfile", { username = profileSearch.Text })
			if response.ok and response.data then
				local found = response.data
				setRow(
					profileResult,
					`{found.displayName} (@{found.username})`,
					`{UIFactory.formatNumber(found.coins)} Coins • {found.joins} joins`,
					"profile"
				)
			else
				setRow(
					profileResult,
					"Player not found",
					response.message or "Check the exact username.",
					"search"
				)
			end
		end)
	end)

	local settingsButtons = {
		reducedMotion = textButton(settingsContent, "ReducedMotionButton"),
		announcements = textButton(settingsContent, "AnnouncementsButton"),
		afKRollOver = textButton(settingsContent, "AfkButton"),
		notifications = textButton(settingsContent, "NotificationsButton"),
	}
	for key, settingsButton in settingsButtons do
		local settingKey = key
		settingsButton.Activated:Connect(function()
			if not state then
				return
			end
			local current = state.profile.settings[settingKey]
			if settingKey == "notifications" and not current then
				context.promptNotifications()
			end
			context.request("UpdateSetting", { key = settingKey, value = not current })
		end)
	end
	textButton(settingsContent, "MusicButton").Activated:Connect(function()
		if state then
			context.request(
				"UpdateSetting",
				{ key = "musicVolume", value = (state.profile.settings.musicVolume + 0.25) % 1.25 }
			)
		end
	end)
	textButton(settingsContent, "SfxButton").Activated:Connect(function()
		if state then
			context.request(
				"UpdateSetting",
				{ key = "sfxVolume", value = (state.profile.settings.sfxVolume + 0.25) % 1.25 }
			)
		end
	end)
	textButton(settingsContent, "ScaleButton").Activated:Connect(function()
		if state then
			local nextScale = state.profile.settings.uiScale + 0.1
			if nextScale > 1.2 then
				nextScale = 0.8
			end
			context.request("UpdateSetting", { key = "uiScale", value = nextScale })
		end
	end)

	local feedbackCategories = { "Bug", "Feedback", "Accessibility", "Other" }
	local feedbackCategoryIndex = 1
	local feedbackCategoryButton = textButton(feedbackContent, "CategoryButton")
	local feedbackInput = textBox(feedbackContent, "MessageInput")
	feedbackCategoryButton.Activated:Connect(function()
		feedbackCategoryIndex = (feedbackCategoryIndex % #feedbackCategories) + 1
		feedbackCategoryButton.Text = `CATEGORY: {string.upper(feedbackCategories[feedbackCategoryIndex])}`
	end)
	textButton(feedbackContent, "SubmitButton").Activated:Connect(function()
		context.request(
			"SubmitFeedback",
			{ category = feedbackCategories[feedbackCategoryIndex], message = feedbackInput.Text }
		)
	end)

	local codeInput = textBox(codesContent, "CodeInput")
	textButton(codesContent, "RedeemButton").Activated:Connect(function()
		context.request("RedeemCode", { code = codeInput.Text })
	end)

	local function showList(title: string, rows: { any })
		textLabel(screenMap.Dynamic, "Title").Text = title
		hideFrames(globalRows)
		for index, entry in rows do
			local rowValue = globalRows[index]
			if not rowValue then
				break
			end
			setRow(
				rowValue,
				`#{entry.rank or index}  {entry.name}`,
				`{UIFactory.formatNumber(entry.value)} Coins`,
				"leaderboard"
			)
		end
		context.open("Dynamic")
	end

	textButton(boardsContent, "GlobalButton").Activated:Connect(function()
		task.spawn(function()
			local response = context.query("GlobalLeaderboard", {})
			if response.ok and response.data then
				showList("Global Leaderboard", response.data)
			else
				context.toast(response.message or "Global leaderboard unavailable")
			end
		end)
	end)

	local function apply(nextState: any)
		state = nextState
		refreshInventory()
		refreshStore()

		local streakCard = frame(rewardsContent, "StreakCard")
		setRow(
			streakCard,
			`Daily streak: Day {state.profile.daily.streak}`,
			"Come back tomorrow to keep your streak going!",
			"daily"
		)
		local nextRewardDay = math.clamp(state.profile.daily.streak + 1, 1, 7)
		for day, tile in rewardTiles do
			textLabel(tile, "AmountLabel").Text = `+{UIFactory.formatNumber(state.dailyRewards[day])}`
			local stateLabel = textLabel(tile, "StateLabel")
			if day == nextRewardDay then
				tile.BackgroundColor3 = Theme.colors.surfaceRaised
				stateLabel.Text = "NEXT REWARD"
				stateLabel.TextColor3 = Theme.colors.primary
			else
				tile.BackgroundColor3 = Theme.colors.surface
				stateLabel.Text = "COINS"
				stateLabel.TextColor3 = Theme.colors.textMuted
			end
			applyIcon(frame(tile, "CoinBadge"), "coin")
		end
		setRow(
			frame(rewardsContent, "OfflineCard"),
			"Offline earnings",
			`{UIFactory.formatNumber(state.offline.amount)} Coins ready from {math.floor(
				state.offline.elapsed / 60
			)} minutes.`,
			"offline"
		)
		textButton(rewardsContent, "ExtendedOfflineButton").Visible = state.productAvailability.extendedOffline
			and not state.profile.entitlements.extendedOffline

		setRow(
			frame(profileContent, "StatsCard"),
			Players.LocalPlayer.DisplayName,
			`Coins: {UIFactory.formatNumber(state.profile.coins)} • Joins: {state.profile.stats.joins} • Playtime: {math.floor(
				state.profile.stats.playSeconds / 60
			)}m`,
			"profile"
		)
		setRow(
			frame(profileContent, "SearchIntro"),
			"Find a player",
			"Search an exact Roblox username to view public stats.",
			"search"
		)

		local settings = state.profile.settings
		settingsButtons.reducedMotion.Text =
			`REDUCED MOTION: {if settings.reducedMotion then "ON" else "OFF"}`
		settingsButtons.announcements.Text = `GAME TIPS: {if settings.announcements then "ON" else "OFF"}`
		settingsButtons.afKRollOver.Text = `STAY CONNECTED: {if settings.afKRollOver then "ON" else "OFF"}`
		settingsButtons.notifications.Text = `REMINDERS: {if settings.notifications then "ON" else "OFF"}`
		textButton(settingsContent, "MusicButton").Text = `MUSIC: {math.floor(settings.musicVolume * 100)}%`
		textButton(settingsContent, "SfxButton").Text = `SFX: {math.floor(settings.sfxVolume * 100)}%`
		textButton(settingsContent, "ScaleButton").Text = `UI SCALE: {math.floor(settings.uiScale * 100)}%`
		setRow(
			frame(settingsContent, "SavedCard"),
			"You're all set!",
			"Your choices save automatically. You can change them again any time.",
			"settings"
		)

		setRow(
			frame(codesContent, "LikesCard"),
			`Likes: {UIFactory.formatNumber(state.likes.value or 0)}`,
			state.likes.reason or "Thanks for supporting the experience!",
			"likes"
		)
		for index = 1, 4 do
			local milestoneCard = frame(codesContent, `Milestone{string.format("%02d", index)}`)
			local milestone = state.likesMilestones[index]
			if milestone then
				local unlocked = (state.likes.value or 0) >= milestone.likes
				setRow(
					milestoneCard,
					`{milestone.likes} Likes`,
					if unlocked
						then `{milestone.label} - Code: {milestone.code}`
						else `{milestone.label} - Locked`,
					"codes"
				)
			else
				milestoneCard.Visible = false
			end
		end

		hideFrames(serverRows)
		for index, entry in state.serverLeaderboard do
			local rowValue = serverRows[index]
			if not rowValue then
				break
			end
			setRow(
				rowValue,
				`#{entry.rank or index}  {entry.name}`,
				`{UIFactory.formatNumber(entry.value)} Coins`,
				"leaderboard"
			)
		end

		local availability = state.integrationAvailability
		setRow(
			frame(communityContent, "CommunityCard"),
			"Roblox Community",
			if availability.community
				then "Community rewards are ready!"
				else "Community rewards are coming soon.",
			"verification"
		)
		setRow(
			frame(communityContent, "ClubsCard"),
			"Clubs",
			if availability.guilds
				then "Clubs are ready!"
				else "Team up with friends when clubs arrive later.",
			"community"
		)
	end

	return {
		screens = screenMap,
		apply = apply,
		showList = showList,
	}
end

return Screens
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">UIFactory</string>
              <string name="Source"><![CDATA[--!strict

-- Visual UI is authored as real StarterGui instances in TemplateUI.model.json.
-- This module intentionally contains only presentation-safe formatting helpers.
local UIFactory = {}

function UIFactory.formatNumber(value: number): string
	local suffixes = { "", "K", "M", "B", "T", "Qa" }
	local absolute = math.abs(value)
	local index = 1
	while absolute >= 1000 and index < #suffixes do
		absolute /= 1000
		value /= 1000
		index += 1
	end
	if index == 1 then
		return tostring(math.floor(value))
	end
	return `{string.format("%.1f", value)}{suffixes[index]}`
end

return table.freeze(UIFactory)
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
