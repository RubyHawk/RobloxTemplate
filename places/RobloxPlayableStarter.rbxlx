        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">CurrencyConfig</string>
            <string name="Source"><![CDATA[--!strict

local CurrencyConfig = {}

CurrencyConfig.MAX_CURRENCIES = 5

export type Definition = {
	id: string,
	name: string,
	symbol: string,
	color: { number },
	startingAmount: number,
}

local DEFAULT: Definition = {
	id = "coins",
	name = "Coins",
	symbol = "$",
	color = { 255, 202, 10 },
	startingAmount = 0,
}

local function validId(value: any): boolean
	return type(value) == "string"
		and #value >= 1
		and #value <= 24
		and string.match(value, "^[a-z][a-z0-9_]*$") ~= nil
end

local function channel(value: any, fallback: number): number
	return if type(value) == "number" and value == value
		then math.clamp(math.floor(value), 0, 255)
		else fallback
end

function CurrencyConfig.normalize(raw: any): { Definition }
	local result: { Definition } = {}
	local used: { [string]: boolean } = {}
	if type(raw) == "table" then
		for _, candidate in raw do
			if #result >= CurrencyConfig.MAX_CURRENCIES or type(candidate) ~= "table" then
				break
			end
			local id = candidate.id
			if not validId(id) or used[id] then
				continue
			end
			local name = if type(candidate.name) == "string"
					and #candidate.name >= 1
					and #candidate.name <= 24
				then candidate.name
				else id
			local symbol = if type(candidate.symbol) == "string"
					and #candidate.symbol >= 1
					and #candidate.symbol <= 4
				then candidate.symbol
				else string.upper(string.sub(name, 1, 1))
			local rawColor = if type(candidate.color) == "table" then candidate.color else {}
			local startingAmount = if type(candidate.startingAmount) == "number"
					and candidate.startingAmount == candidate.startingAmount
				then math.clamp(math.floor(candidate.startingAmount), 0, 1e12)
				else 0
			used[id] = true
			table.insert(result, {
				id = id,
				name = name,
				symbol = symbol,
				color = {
					channel(rawColor[1], DEFAULT.color[1]),
					channel(rawColor[2], DEFAULT.color[2]),
					channel(rawColor[3], DEFAULT.color[3]),
				},
				startingAmount = startingAmount,
			})
		end
	end
	if #result == 0 then
		table.insert(result, {
			id = DEFAULT.id,
			name = DEFAULT.name,
			symbol = DEFAULT.symbol,
			color = table.clone(DEFAULT.color),
			startingAmount = DEFAULT.startingAmount,
		})
	end
	return result
end

function CurrencyConfig.startingBalances(currencies: { Definition }): { [string]: number }
	local balances: { [string]: number } = {}
	for _, definition in currencies do
		balances[definition.id] = definition.startingAmount
	end
	return balances
end

-- Shared by profile creation and migration so every path agrees on balances:
-- profiles saved before schema 2 move their single legacy `coins` number into
-- the primary currency, a currency the profile has never held starts at its
-- configured startingAmount (never retroactively re-granted once the key
-- exists), and the legacy `coins` field keeps mirroring the primary balance
-- for old readers. Balances a profile already has are left untouched.
function CurrencyConfig.reconcileProfileCurrencies(
	profile: any,
	currencies: { Definition },
	primaryId: string,
	previousVersion: number
)
	if type(profile.currencies) ~= "table" then
		profile.currencies = {}
	end
	if previousVersion < 2 then
		profile.currencies[primaryId] = if type(profile.coins) == "number" then profile.coins else 0
	end
	for _, definition in currencies do
		if type(profile.currencies[definition.id]) ~= "number" then
			profile.currencies[definition.id] = definition.startingAmount
		end
	end
	profile.coins = profile.currencies[primaryId]
end

return CurrencyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">DesignerConfig</string>
            <string name="Source"><![CDATA[--!strict

-- The default recipe used by the normal template build. The desktop Game
-- Designer writes a separate generated copy for exported test experiences;
-- it never rewrites this source file or another preset's authored UI.
return {
	preset = "incremental",
	currencies = {
		{
			id = "coins",
			name = "Coins",
			symbol = "$",
			color = { 255, 202, 10 },
			startingAmount = 2500,
		},
	},
	features = {},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">FeatureRegistry</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(script.Parent.TemplateConfig)

local FeatureRegistry = {}

function FeatureRegistry.isEnabled(name: string): boolean
	return Config.features[name] == true
end

function FeatureRegistry.requireEnabled(name: string): (boolean, string?)
	if FeatureRegistry.isEnabled(name) then
		return true, nil
	end
	return false, `Feature "{name}" is disabled in TemplateConfig`
end

function FeatureRegistry.snapshot(): { [string]: boolean }
	return table.clone(Config.features)
end

return FeatureRegistry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">IconCatalog</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(script.Parent.TemplateConfig)

export type IconName =
	"bag"
	| "shop"
	| "rewards"
	| "profile"
	| "more"
	| "codes"
	| "leaderboard"
	| "community"
	| "feedback"
	| "settings"
	| "coin"
	| "daily"
	| "offline"
	| "premium"
	| "search"
	| "close"
	| "likes"
	| "friends"
	| "notifications"
	| "cart"
	| "verification"
	| "item"
	| "starterTool"
	| "potionX2"
	| "potionX3"

export type SourceDefinition = {
	file: string,
	fallback: string,
}

local sources: { [IconName]: SourceDefinition } = {
	bag = { file = "bag.png", fallback = "rbxasset://textures/ui/TopBar/inventoryOff@3x.png" },
	shop = { file = "shop.png", fallback = "" },
	rewards = { file = "rewards.png", fallback = "rbxasset://textures/ui/InspectMenu/ico_favorite@3x.png" },
	profile = {
		file = "profile.png",
		fallback = "rbxasset://textures/ui/Settings/MenuBarIcons/PlayersTabIcon@2x.png",
	},
	more = { file = "more.png", fallback = "rbxasset://textures/ui/TopBar/moreOff@3x.png" },
	codes = { file = "codes.png", fallback = "" },
	leaderboard = { file = "leaderboard.png", fallback = "" },
	community = { file = "community.png", fallback = "" },
	feedback = { file = "feedback.png", fallback = "" },
	settings = { file = "settings.png", fallback = "" },
	coin = { file = "coin.png", fallback = "" },
	daily = { file = "daily.png", fallback = "" },
	offline = { file = "offline.png", fallback = "" },
	premium = { file = "premium.png", fallback = "" },
	search = { file = "search.png", fallback = "" },
	close = { file = "close.png", fallback = "" },
	likes = { file = "likes.png", fallback = "" },
	friends = { file = "friends.png", fallback = "" },
	notifications = { file = "notifications.png", fallback = "" },
	cart = { file = "cart.png", fallback = "" },
	verification = { file = "verification.png", fallback = "" },
	item = { file = "item.png", fallback = "" },
	starterTool = { file = "starter_tool.png", fallback = "" },
	potionX2 = { file = "potion_x2.png", fallback = "" },
	potionX3 = { file = "potion_x3.png", fallback = "" },
}

local configured: { [IconName]: string } = Config.icons

local function normalize(assetId: string): string
	if assetId == "" then
		return ""
	end
	if string.find(assetId, "^rbxasset") then
		return assetId
	end
	return `rbxassetid://{assetId}`
end

local IconCatalog = {}

function IconCatalog.get(name: IconName): string
	local configuredId = normalize(configured[name])
	if configuredId ~= "" then
		return configuredId
	end
	return sources[name].fallback
end

function IconCatalog.isPackConfigured(name: IconName): boolean
	return configured[name] ~= ""
end

IconCatalog.sources = table.freeze(sources)

return table.freeze(IconCatalog)
]]></string>
          </Properties>
