  <Item class="StarterGui" referent="48">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="49">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="50">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="51">
        <Properties>
          <string name="Name">TemplateClient</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Template"):WaitForChild("Shared")
local IconCatalog = require(Shared.IconCatalog)
local RemoteNames = require(Shared.RemoteNames)
local Theme = require(Shared.Theme)

type IconName = IconCatalog.IconName

local Controllers = script.Controllers
local AudioController = require(Controllers.AudioController)
local AfkController = require(Controllers.AfkController)
local NotificationController = require(Controllers.NotificationController)
local UIFactory = require(script.UI.UIFactory)
local UIStyles = require(script.UI.UIStyles)
local ScreenRegistry = require(script.UI.ScreenRegistry)
local Screens = require(script.UI.Screens)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild(RemoteNames.folder)
local requestRemote = remotes:WaitForChild(RemoteNames.request) :: RemoteEvent
local stateRemote = remotes:WaitForChild(RemoteNames.state) :: RemoteEvent
local queryRemote = remotes:WaitForChild(RemoteNames.query) :: RemoteFunction

task.spawn(function()
	for _ = 1, 10 do
		local success = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
		end)
		if success then
			break
		end
		task.wait(0.25)
	end
end)

local playerGui = player:WaitForChild("PlayerGui")
local screenGui = playerGui:WaitForChild("TemplateUI") :: ScreenGui
assert(screenGui:IsA("ScreenGui"), "StarterGui.TemplateUI must be a ScreenGui")
screenGui.Enabled = true
UIStyles.install(screenGui)

local root = screenGui:WaitForChild("Root") :: Frame
local uiScale = root:WaitForChild("InterfaceScale") :: UIScale
local hud = root:WaitForChild("CurrencyHUD") :: Frame
local coinLabel = hud:WaitForChild("CoinLabel") :: TextLabel
local boostLabel = hud:WaitForChild("BoostLabel") :: TextLabel
local addCoinsButton = hud:WaitForChild("AddCoinsButton") :: TextButton
local nav = root:WaitForChild("Navigation") :: Frame
local navScroll = nav:WaitForChild("Buttons") :: ScrollingFrame
local moreMenu = root:WaitForChild("MoreMenu") :: Frame
local moreMenuButtons = moreMenu:WaitForChild("Buttons") :: ScrollingFrame
local moreCloseButton = moreMenu:WaitForChild("CloseButton") :: TextButton
local screensLayer = root:WaitForChild("Screens") :: Frame
local toast = root:WaitForChild("Toast") :: Frame
local toastLabel = toast:WaitForChild("Message") :: TextLabel
local toastToken = 0

local function applyIcon(container: Instance, name: IconName, imageName: string, fallbackName: string?)
	local image = container:FindFirstChild(imageName)
	if not image or not image:IsA("ImageLabel") then
		return
	end
	local content = IconCatalog.get(name)
	if content == "" then
		return
	end
	image.Image = content
	image.Visible = true
	if fallbackName then
		local fallback = container:FindFirstChild(fallbackName)
		if fallback and fallback:IsA("GuiObject") then
			fallback.Visible = false
		end
	end
end

applyIcon(hud:WaitForChild("CoinBadge"), "coin", "Icon", "Symbol")
applyIcon(toast:WaitForChild("IconBadge"), "notifications", "Icon", "Symbol")
applyIcon(moreCloseButton, "close", "Icon", nil)
if IconCatalog.get("close") ~= "" then
	moreCloseButton.Text = ""
end

local function tweenInfo(duration: number, easingStyle: Enum.EasingStyle?): TweenInfo
	local adjustedDuration = if GuiService.ReducedMotionEnabled then 0 else duration
	return if easingStyle
		then TweenInfo.new(adjustedDuration, easingStyle)
		else TweenInfo.new(adjustedDuration)
end

local function showToast(message: string)
	toastToken += 1
	local token = toastToken
	toastLabel.Text = message
	TweenService:Create(toast, tweenInfo(0.2, Enum.EasingStyle.Back), { Position = UDim2.new(0.5, 0, 0, 12) })
		:Play()
	task.delay(3.5, function()
		if token == toastToken then
			TweenService:Create(toast, tweenInfo(0.2), { Position = UDim2.new(0.5, 0, 0, -180) }):Play()
		end
	end)
end

AudioController.initialize()

local function optionalScreenGui(name: string): ScreenGui?
	local candidate = playerGui:FindFirstChild(name)
	return if candidate and candidate:IsA("ScreenGui") then candidate else nil
end

local function ensureGalleryScreen(name: string): ScreenGui?
	local existing = optionalScreenGui(name)
	if existing then
		return existing
	end
	local source = StarterGui:FindFirstChild(name)
	if source and source:IsA("ScreenGui") then
		local clone = source:Clone()
		clone.Parent = playerGui
		return clone
	end
	return nil
end

local function setupGalleryMenu()
	local galleryMenu = ensureGalleryScreen("GalleryMenu")
	if not galleryMenu then
		return
	end
	galleryMenu.Enabled = true

	local packShowroom = ensureGalleryScreen("ZxglyV5Showroom")
	local notificationShowroom = ensureGalleryScreen("NotificationV2Showroom")
	local backdrop = ensureGalleryScreen("GalleryBackdrop")
	local menuRoot = galleryMenu:WaitForChild("Root") :: Frame
	local toolbar = menuRoot:WaitForChild("Toolbar") :: Frame
	local modesFrame = toolbar:WaitForChild("Modes") :: Frame
	local modeCard = menuRoot:WaitForChild("ModeCard") :: Frame
	local description = modeCard:WaitForChild("Description") :: TextLabel

	local modes = {
		{
			name = "Connected",
			buttonName = "ConnectedButton",
			description = "Connected UI: the real HUD and systems. Use this to test the starter experience.",
			heading = "CONNECTED TEMPLATE UI",
			detail = "The real inventory, store, rewards, profiles, settings, and HUD.",
		},
		{
			name = "Pack",
			buttonName = "PackButton",
			description = "UI Pack: a script-free component sheet. Edit ZxglyV5Showroom under StarterGui.",
			heading = "VISUAL UI PACK",
			detail = "Script-free reference screens arranged as one isolated component sheet.",
		},
		{
			name = "Notification",
			buttonName = "NotificationButton",
			description = "Notification: one isolated visual preview. Runtime messages still use secure template logic.",
			heading = "NOTIFICATION PREVIEW",
			detail = "Visual reference only; supplied third-party scripts were intentionally removed.",
		},
	}

	local buttons: { [string]: TextButton } = {}
	local function setMode(modeName: string)
		screenGui.Enabled = modeName == "Connected"
		if packShowroom then
			packShowroom.Enabled = modeName == "Pack"
		end
		if notificationShowroom then
			notificationShowroom.Enabled = modeName == "Notification"
		end
		if backdrop then
			backdrop.Enabled = modeName ~= "Connected"
		end

		for _, mode in modes do
			local selected = mode.name == modeName
			buttons[mode.name].BackgroundColor3 = if selected
				then Theme.colors.primary
				else Theme.colors.surfaceRaised
			if selected then
				description.Text = mode.description
				if backdrop then
					local background = backdrop:WaitForChild("Background") :: Frame
					local heading = background:WaitForChild("Heading") :: TextLabel
					local detail = background:WaitForChild("Detail") :: TextLabel
					heading.Text = mode.heading
					detail.Text = mode.detail
				end
			end
		end
	end

	for _, mode in modes do
		local button = modesFrame:WaitForChild(mode.buttonName) :: TextButton
		local modeName = mode.name
		buttons[modeName] = button
		button.Activated:Connect(function()
			AudioController.play("click")
			setMode(modeName)
		end)
	end

	setMode("Connected")
end

setupGalleryMenu()
local registry = ScreenRegistry.new()
local state: any = nil

local function request(action: string, payload: any)
	AudioController.play("click")
	requestRemote:FireServer({ action = action, payload = payload })
end

local function query(action: string, payload: any): any
	local success, response = pcall(function()
		return queryRemote:InvokeServer(action, payload)
	end)
	return if success then response else { ok = false, message = "Server request failed" }
end

local rebuildScreens: () -> ()

local function context(): any
	return {
		state = state,
		request = request,
		query = query,
		close = function()
			registry:close()
		end,
		toast = showToast,
		promptNotifications = function()
			task.spawn(function()
				local _, message = NotificationController.prompt()
				showToast(message)
			end)
		end,
		promptProduct = function(productName: string)
			local productId = state.productIds[productName]
			if type(productId) == "number" and productId > 0 then
				MarketplaceService:PromptProductPurchase(player, productId)
			else
				showToast("Product is not configured")
			end
		end,
		promptExtendedOffline = function()
			local passId = state.productIds.extendedOffline
			if type(passId) == "number" and passId > 0 then
				MarketplaceService:PromptGamePassPurchase(player, passId)
			else
				showToast("Game pass is not configured")
			end
		end,
		promptPremium = function()
			MarketplaceService:PromptPremiumPurchase(player)
		end,
		showList = function(title: string, rows: { any })
			local dynamic = registry.screens.Dynamic
			if dynamic then
				dynamic:Destroy()
			end
			registry:register("Dynamic", Screens.simpleList(screensLayer, context(), title, rows))
			registry:open("Dynamic")
		end,
	}
end

rebuildScreens = function()
	local current = registry.current
	registry:destroy()
	registry = ScreenRegistry.new()
	local ctx = context()
	registry:register("Inventory", Screens.inventory(screensLayer, ctx))
	registry:register("Store", Screens.store(screensLayer, ctx))
	registry:register("Rewards", Screens.rewards(screensLayer, ctx))
	registry:register("Profile", Screens.profile(screensLayer, ctx))
	registry:register("Settings", Screens.settings(screensLayer, ctx))
	registry:register("Feedback", Screens.feedback(screensLayer, ctx))
	registry:register("Codes", Screens.codes(screensLayer, ctx))
	registry:register("Boards", Screens.leaderboards(screensLayer, ctx))
	registry:register("Community", Screens.verification(screensLayer, ctx))
	if current and registry.screens[current] then
		registry:open(current)
	end
end

local navItems = {
	{ "BagButton", "Inventory", "bag" },
	{ "ShopButton", "Store", "shop" },
	{ "GiftButton", "Rewards", "rewards" },
	{ "ProfileButton", "Profile", "profile" },
}
for _, item in navItems do
	local button = navScroll:WaitForChild(item[1]) :: TextButton
	local screenName = item[2]
	local iconName = item[3] :: IconName
	applyIcon(button:WaitForChild("IconBubble"), iconName, "PackIcon", "Icon")
	local restingColor = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = Theme.colors.surfaceRaised }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = restingColor }):Play()
	end)
	button.Activated:Connect(function()
		AudioController.play("click")
		moreMenu.Visible = false
		if registry.current == screenName then
			registry:close()
		else
			registry:open(screenName)
		end
	end)
end

local moreButton = navScroll:WaitForChild("MoreButton") :: TextButton
applyIcon(moreButton:WaitForChild("IconBubble"), "more", "PackIcon", "Icon")
local moreButtonRestingColor = moreButton.BackgroundColor3
moreButton.MouseEnter:Connect(function()
	TweenService:Create(moreButton, tweenInfo(0.12), { BackgroundColor3 = Theme.colors.surfaceRaised }):Play()
end)
moreButton.MouseLeave:Connect(function()
	TweenService:Create(moreButton, tweenInfo(0.12), { BackgroundColor3 = moreButtonRestingColor }):Play()
end)
moreButton.Activated:Connect(function()
	AudioController.play("click")
	registry:close()
	moreMenu.Visible = not moreMenu.Visible
end)

moreCloseButton.Activated:Connect(function()
	AudioController.play("click")
	moreMenu.Visible = false
end)

addCoinsButton.Activated:Connect(function()
	AudioController.play("click")
	moreMenu.Visible = false
	if registry.current == "Store" then
		registry:close()
	else
		registry:open("Store")
	end
end)

local moreItems = {
	{ "CodesButton", "Codes", "codes" },
	{ "BoardsButton", "Boards", "leaderboard" },
	{ "CommunityButton", "Community", "community" },
	{ "FeedbackButton", "Feedback", "feedback" },
	{ "SettingsButton", "Settings", "settings" },
}
for _, item in moreItems do
	local button = moreMenuButtons:WaitForChild(item[1]) :: TextButton
	local screenName = item[2]
	local iconName = item[3] :: IconName
	applyIcon(button, iconName, "Icon", "Fallback")
	local restingColor = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = Theme.colors.surfaceRaised }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, tweenInfo(0.12), { BackgroundColor3 = restingColor }):Play()
	end)
	button.Activated:Connect(function()
		AudioController.play("click")
		moreMenu.Visible = false
		registry:open(screenName)
	end)
end

local function applyState(nextState: any)
	if nextState == nil or nextState.profile == nil then
		return
	end
	local previousCoins = if state and state.profile then state.profile.coins else nextState.profile.coins
	state = nextState
	coinLabel.Text = UIFactory.formatNumber(state.profile.coins)
	boostLabel.Text = `x{string.format(
		"%.2f",
		(1 + state.friendBonus + state.premiumBonus) * state.potionMultiplier
	)} BOOST  •  {state.profile.social.friendCountInServer} FRIENDS`
	uiScale.Scale = state.profile.settings.uiScale
	AudioController.applySettings(state.profile.settings)
	if state.profile.coins > previousCoins then
		AudioController.play("cash")
	end
	AfkController.setEnabled(state.profile.settings.afKRollOver)
	rebuildScreens()
end

stateRemote.OnClientEvent:Connect(function(packet)
	if type(packet) ~= "table" then
		return
	end
	if packet.kind == "Snapshot" then
		applyState(packet.data)
	elseif packet.kind == "Result" then
		showToast(packet.message or if packet.ok then "Done" else "Request failed")
		if packet.ok then
			AudioController.play("reward")
		end
	elseif packet.kind == "Announcement" and state and state.profile.settings.announcements then
		showToast(packet.message)
		local channels = TextChatService:FindFirstChild("TextChannels")
		local systemChannel = if channels then channels:FindFirstChild("RBXSystem") else nil
		if systemChannel and systemChannel:IsA("TextChannel") then
			systemChannel:DisplaySystemMessage(`[SYSTEM] {packet.message}`)
		end
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and (input.KeyCode == Enum.KeyCode.ButtonB or input.KeyCode == Enum.KeyCode.Escape) then
		if moreMenu.Visible then
			moreMenu.Visible = false
		else
			registry:close()
		end
	end
end)

AfkController.initialize(function()
	request("AfkRollover", {})
end, showToast)

task.spawn(function()
	for _ = 1, 30 do
		local response = query("InitialState", {})
		if response.ok and response.data then
			applyState(response.data)
			return
		end
		task.wait(1)
	end
	showToast("Profile did not load. Rejoin to retry.")
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="52">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">AfkController</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Config = require(
	game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").TemplateConfig
)

local AfkController = {}
local enabled = true
local countdownToken = 0

function AfkController.setEnabled(value: boolean)
	enabled = value
	if not enabled then
		countdownToken += 1
	end
end

function AfkController.initialize(requestRollOver: () -> (), notify: (string) -> ())
	UserInputService.InputBegan:Connect(function()
		countdownToken += 1
	end)

	Players.LocalPlayer.Idled:Connect(function(idleSeconds)
		if not enabled or idleSeconds < Config.afK.warnAfterIdleSeconds then
			return
		end
		countdownToken += 1
		local token = countdownToken
		notify(`AFK: moving to a fresh server in {Config.afK.countdownSeconds}s. Press any input to cancel.`)
		task.delay(Config.afK.countdownSeconds, function()
			if enabled and token == countdownToken then
				requestRollOver()
			end
		end)
	end)
end

return AfkController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict

local SoundService = game:GetService("SoundService")

local Config = require(
	game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").TemplateConfig
)

local AudioController = {}
local sounds: { [string]: Sound } = {}
local musicGroup: SoundGroup
local sfxGroup: SoundGroup

local function group(name: string): SoundGroup
	local existing = SoundService:FindFirstChild(name)
	if existing and existing:IsA("SoundGroup") then
		return existing
	end
	local created = Instance.new("SoundGroup")
	created.Name = name
	created.Parent = SoundService
	return created
end

function AudioController.initialize()
	musicGroup = group("TemplateMusic")
	sfxGroup = group("TemplateSFX")
	for name, assetId in Config.audio do
		if assetId ~= "" then
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = assetId
			sound.SoundGroup = if name == "music" then musicGroup else sfxGroup
			sound.Looped = name == "music"
			sound.Parent = SoundService
			sounds[name] = sound
		end
	end
	if sounds.music then
		sounds.music:Play()
	end
end

function AudioController.applySettings(settings: any)
	if musicGroup then
		musicGroup.Volume = math.clamp(settings.musicVolume or 0.5, 0, 1)
	end
	if sfxGroup then
		sfxGroup.Volume = math.clamp(settings.sfxVolume or 0.7, 0, 1)
	end
end

function AudioController.play(name: string)
	local sound = sounds[name]
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--!strict

local ExperienceNotificationService = game:GetService("ExperienceNotificationService")

local NotificationController = {}

function NotificationController.prompt(): (boolean, string)
	local success, canPrompt = pcall(function()
		return ExperienceNotificationService:CanPromptOptInAsync()
	end)
	if not success then
		return false, "Notification eligibility could not be checked"
	end
	if not canPrompt then
		return false, "Roblox notifications are already configured or unavailable for this account"
	end
	local promptSuccess = pcall(function()
		ExperienceNotificationService:PromptOptIn()
	end)
	return promptSuccess,
		if promptSuccess then "Roblox opened the notification prompt" else "Notification prompt failed"
end

return NotificationController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="56">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">ScreenRegistry</string>
              <string name="Source"><![CDATA[--!strict

local ScreenRegistry = {}
ScreenRegistry.__index = ScreenRegistry

export type ScreenRegistry = typeof(setmetatable(
	{} :: {
		screens: { [string]: GuiObject },
		current: string?,
	},
	ScreenRegistry
))

function ScreenRegistry.new(): ScreenRegistry
	return setmetatable({ screens = {}, current = nil }, ScreenRegistry)
end

function ScreenRegistry.register(self: ScreenRegistry, name: string, screen: GuiObject)
	self.screens[name] = screen
	screen.Visible = false
end

function ScreenRegistry.open(self: ScreenRegistry, name: string)
	for screenName, screen in self.screens do
		screen.Visible = screenName == name
	end
	self.current = name
end

function ScreenRegistry.close(self: ScreenRegistry)
	for _, screen in self.screens do
		screen.Visible = false
	end
	self.current = nil
end

function ScreenRegistry.destroy(self: ScreenRegistry)
	for _, screen in self.screens do
		screen:Destroy()
	end
	table.clear(self.screens)
	self.current = nil
end

return ScreenRegistry
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">Screens</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local IconCatalog = require(Shared.IconCatalog)
local Theme = require(Shared.Theme)
local UIFactory = require(script.Parent.UIFactory)

type IconName = IconCatalog.IconName

local Screens = {}

local function applyIcon(container: Instance, name: IconName)
	local icon = container:FindFirstChild("Icon")
	if not icon or not icon:IsA("ImageLabel") then
		return
	end
	local content = IconCatalog.get(name)
	if content == "" then
		return
	end
	icon.Image = content
	icon.Visible = true
	local fallback = container:FindFirstChild("Symbol") or container:FindFirstChild("Fallback")
	if fallback and fallback:IsA("GuiObject") then
		fallback.Visible = false
	end
end

local function authoredTemplate(parent: Instance, name: string, className: string): Instance
	local screenGui = parent:FindFirstAncestorWhichIsA("ScreenGui")
	local root = if screenGui then screenGui:FindFirstChild("Root") else nil
	local templates = if root then root:FindFirstChild("ComponentTemplates") else nil
	local template = if templates then templates:FindFirstChild(name) else nil
	assert(
		template and template.ClassName == className,
		`TemplateUI.Root.ComponentTemplates.{name} must be a {className}`
	)
	return template
end

local function base(parent: Instance, title: string, close: () -> ()): (Frame, ScrollingFrame)
	local template = parent.Parent and parent.Parent:FindFirstChild("ScreenTemplate")
	assert(template and template:IsA("Frame"), "TemplateUI.Root.ScreenTemplate must be a Frame")

	local root = template:Clone()
	root.Name = `{title}Screen`
	root.Visible = true
	local titleLabel = root:WaitForChild("Title") :: TextLabel
	titleLabel.Text = title
	local closeButton = root:WaitForChild("CloseButton") :: TextButton
	applyIcon(closeButton, "close")
	if IconCatalog.get("close") ~= "" then
		closeButton.Text = ""
	end
	closeButton.Activated:Connect(close)
	local content = root:WaitForChild("Content") :: ScrollingFrame
	root.Parent = parent
	return root, content
end

local function row(parent: Instance, title: string, body: string, iconName: IconName?): Frame
	local template = authoredTemplate(parent, "RowTemplate", "Frame") :: Frame
	local card = template:Clone()
	card.Name = title
	card.Visible = true
	local titleLabel = card:WaitForChild("Title") :: TextLabel
	titleLabel.Text = title
	local bodyLabel = card:WaitForChild("Body") :: TextLabel
	bodyLabel.Text = body
	local iconBadge = card:WaitForChild("IconBadge") :: Frame
	local symbol = iconBadge:WaitForChild("Symbol") :: TextLabel
	symbol.Text = string.upper(string.sub(title, 1, 1))
	if iconName then
		applyIcon(iconBadge, iconName)
	end
	card.Parent = parent
	return card
end

local function itemCard(
	parent: Instance,
	title: string,
	body: string,
	actionText: string,
	onActivated: () -> (),
	display: { glyph: string?, icon: string? }?
): Frame
	local template = authoredTemplate(parent, "ItemCardTemplate", "Frame") :: Frame
	local card = template:Clone()
	card.Name = title
	card.Visible = true
	local titleLabel = card:WaitForChild("Title") :: TextLabel
	titleLabel.Text = title
	local bodyLabel = card:WaitForChild("Body") :: TextLabel
	bodyLabel.Text = body
	local artwork = card:WaitForChild("Artwork") :: Frame
	local glyph = artwork:WaitForChild("Glyph") :: TextLabel
	local icon = artwork:WaitForChild("Icon") :: ImageLabel
	if display and display.icon and display.icon ~= "" then
		icon.Image = display.icon
		icon.Visible = true
		glyph.Visible = false
	else
		glyph.Text = if display and display.glyph
			then display.glyph
			else string.upper(string.sub(title, 1, 1))
	end
	local action = card:WaitForChild("ActionButton") :: TextButton
	action.Text = actionText
	action.AutoButtonColor = true
	action.Activated:Connect(onActivated)
	card.Parent = parent
	return card
end

local function rewardTile(parent: Instance, day: number, amount: number, nextDay: number): Frame
	local template = authoredTemplate(parent, "RewardTileTemplate", "Frame") :: Frame
	local tile = template:Clone()
	tile.Name = `Day{day}`
	tile.LayoutOrder = day
	tile.Visible = true
	local dayLabel = tile:WaitForChild("DayLabel") :: TextLabel
	dayLabel.Text = `DAY {day}`
	local amountLabel = tile:WaitForChild("AmountLabel") :: TextLabel
	amountLabel.Text = `+{UIFactory.formatNumber(amount)}`
	local stateLabel = tile:WaitForChild("StateLabel") :: TextLabel
	applyIcon(tile:WaitForChild("CoinBadge"), "coin")
	if day == nextDay then
		tile.BackgroundColor3 = Theme.colors.surfaceRaised
		stateLabel.Text = "NEXT REWARD"
		stateLabel.TextColor3 = Theme.colors.primary
	else
		stateLabel.Text = "COINS"
	end
	tile.Parent = parent
	return tile
end

function Screens.inventory(parent: Instance, context: any): Frame
	local root, content = base(parent, "My Bag", context.close)
	local entries = context.state.profile.inventory
	local anyItem = false
	for itemId, entry in entries do
		if entry.quantity > 0 then
			anyItem = true
			local definition = context.state.catalog[itemId]
			if definition then
				local action = if definition.category == "Consumable" then "UseItem" else "ToggleEquip"
				local label = if definition.category == "Consumable"
					then "USE"
					else if entry.equipped then "UNEQUIP" else "EQUIP"
				itemCard(
					content,
					`{definition.name}  ×{entry.quantity}`,
					definition.description,
					label,
					function()
						context.request(action, { itemId = itemId })
					end,
					{
						glyph = if definition.boostMultiplier then `x{definition.boostMultiplier}` else nil,
						icon = definition.icon,
					}
				)
			end
		end
	end
	if not anyItem then
		row(content, "Your bag is empty", "Items and boosts you collect will appear here.", "item")
	end
	return root
end

function Screens.store(parent: Instance, context: any): Frame
	local root, content = base(parent, "Shop", context.close)
	for itemId, definition in context.state.catalog do
		if definition.priceCoins then
			itemCard(
				content,
				definition.name,
				`{definition.description}  •  {UIFactory.formatNumber(definition.priceCoins)} Coins`,
				"BUY",
				function()
					context.request("BuyItem", { itemId = itemId })
				end,
				{
					glyph = if definition.boostMultiplier then `x{definition.boostMultiplier}` else nil,
					icon = definition.icon,
				}
			)
		end
	end
	if context.state.productAvailability.coinPackSmall then
		itemCard(
			content,
			"Small Coins Pack",
			"A quick coin top-up. Roblox shows the final price.",
			"VIEW",
			function()
				context.promptProduct("coinPackSmall")
			end,
			{ glyph = "C" }
		)
	else
		row(content, "Coin packs", "More shop options are coming soon!", "cart")
	end
	if context.state.productAvailability.coinPackLarge then
		itemCard(
			content,
			"Large Coins Pack",
			"A larger coin top-up. Roblox shows the final price.",
			"VIEW",
			function()
				context.promptProduct("coinPackLarge")
			end,
			{ glyph = "C" }
		)
	end
	local premiumText = if context.state.profile.entitlements.premium
		then "Active: permanent +10% Coins bonus."
		else "Roblox Premium members receive a permanent +10% Coins bonus."
	local premiumCard = row(content, "Roblox Premium", premiumText, "premium")
	if not context.state.profile.entitlements.premium then
		UIFactory.button(premiumCard, "VIEW", context.promptPremium, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(92, 44),
		})
	end
	return root
end

function Screens.rewards(parent: Instance, context: any): Frame
	local root, content = base(parent, "Daily Rewards", context.close)
	row(
		content,
		`Daily streak: Day {context.state.profile.daily.streak}`,
		"Come back tomorrow to keep your streak going!",
		"daily"
	)
	local rewardStrip = Instance.new("ScrollingFrame")
	rewardStrip.Name = "RewardStrip"
	rewardStrip.AutomaticCanvasSize = Enum.AutomaticSize.X
	rewardStrip.BackgroundTransparency = 1
	rewardStrip.BorderSizePixel = 0
	rewardStrip.CanvasSize = UDim2.new()
	rewardStrip.ScrollingDirection = Enum.ScrollingDirection.X
	rewardStrip.ScrollBarImageColor3 = Theme.colors.primary
	rewardStrip.ScrollBarThickness = 4
	rewardStrip.Size = UDim2.new(1, -8, 0, 142)
	local rewardLayout = Instance.new("UIListLayout")
	rewardLayout.FillDirection = Enum.FillDirection.Horizontal
	rewardLayout.Padding = UDim.new(0, 8)
	rewardLayout.SortOrder = Enum.SortOrder.LayoutOrder
	rewardLayout.Parent = rewardStrip
	rewardStrip.Parent = content
	local nextRewardDay = math.clamp(context.state.profile.daily.streak + 1, 1, 7)
	for day, amount in context.state.dailyRewards do
		rewardTile(rewardStrip, day, amount, nextRewardDay)
	end
	UIFactory.button(content, "CLAIM DAILY REWARD", function()
		context.request("ClaimDaily", {})
	end)
	local pending = context.state.offline
	row(
		content,
		"Offline earnings",
		`{UIFactory.formatNumber(pending.amount)} Coins ready from {math.floor(pending.elapsed / 60)} minutes.`,
		"offline"
	)
	UIFactory.button(content, "CLAIM OFFLINE EARNINGS", function()
		context.request("ClaimOffline", {})
	end, { BackgroundColor3 = Theme.colors.success })
	if
		context.state.productAvailability.extendedOffline
		and not context.state.profile.entitlements.extendedOffline
	then
		UIFactory.button(content, "EXTEND OFFLINE CAP TO 12 HOURS", context.promptExtendedOffline)
	end
	return root
end

function Screens.profile(parent: Instance, context: any): Frame
	local root, content = base(parent, "My Profile", context.close)
	local profile = context.state.profile
	row(
		content,
		Players.LocalPlayer.DisplayName,
		`Coins: {UIFactory.formatNumber(profile.coins)}  •  Joins: {profile.stats.joins}  •  Playtime: {math.floor(
			profile.stats.playSeconds / 60
		)}m`,
		"profile"
	)
	row(content, "Find a player", "Search an exact Roblox username to view public stats.", "search")
	local input = UIFactory.textBox(content, "Exact Roblox username")
	local resultLabel = UIFactory.label(content, "Search for a Roblox player to see their public stats.", {
		Size = UDim2.new(1, -8, 0, 54),
		TextColor3 = Theme.colors.textMuted,
	})
	UIFactory.button(content, "SEARCH PLAYER", function()
		resultLabel.Text = "Searching…"
		task.spawn(function()
			local response = context.query("SearchProfile", { username = input.Text })
			if response.ok and response.data then
				local found = response.data
				resultLabel.Text = `{found.displayName} (@{found.username}) • {UIFactory.formatNumber(
					found.coins
				)} Coins • {found.joins} joins`
			else
				resultLabel.Text = response.message or "Player was not found"
			end
		end)
	end)
	return root
end

function Screens.settings(parent: Instance, context: any): Frame
	local root, content = base(parent, "Settings", context.close)
	local settings = context.state.profile.settings
	local function toggle(label: string, key: string, value: boolean)
		UIFactory.button(content, `{label}: {if value then "ON" else "OFF"}`, function()
			if key == "notifications" and not value then
				context.promptNotifications()
			end
			context.request("UpdateSetting", { key = key, value = not value })
		end)
	end
	toggle("Reduced motion", "reducedMotion", settings.reducedMotion)
	toggle("Game tips", "announcements", settings.announcements)
	toggle("Stay connected", "afKRollOver", settings.afKRollOver)
	toggle("Reminders", "notifications", settings.notifications)
	UIFactory.button(content, `Music: {math.floor(settings.musicVolume * 100)}%`, function()
		context.request(
			"UpdateSetting",
			{ key = "musicVolume", value = (settings.musicVolume + 0.25) % 1.25 }
		)
	end)
	UIFactory.button(content, `SFX: {math.floor(settings.sfxVolume * 100)}%`, function()
		context.request("UpdateSetting", { key = "sfxVolume", value = (settings.sfxVolume + 0.25) % 1.25 })
	end)
	UIFactory.button(content, `UI Scale: {math.floor(settings.uiScale * 100)}%`, function()
		local nextScale = settings.uiScale + 0.1
		if nextScale > 1.2 then
			nextScale = 0.8
		end
		context.request("UpdateSetting", { key = "uiScale", value = nextScale })
	end)
	row(
		content,
		"You're all set!",
		"Your choices save automatically. You can change them again any time.",
		"settings"
	)
	return root
end

function Screens.feedback(parent: Instance, context: any): Frame
	local root, content = base(parent, "Send Feedback", context.close)
	local categories = { "Bug", "Feedback", "Accessibility", "Other" }
	local categoryIndex = 1
	local categoryButton = UIFactory.button(content, "Category: Bug", nil)
	categoryButton.Activated:Connect(function()
		categoryIndex = (categoryIndex % #categories) + 1
		categoryButton.Text = `Category: {categories[categoryIndex]}`
	end)
	local input = UIFactory.textBox(content, "Describe the issue (3–500 characters)", {
		MultiLine = true,
		Size = UDim2.new(1, -8, 0, 140),
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	UIFactory.button(content, "SUBMIT", function()
		context.request("SubmitFeedback", { category = categories[categoryIndex], message = input.Text })
	end, { BackgroundColor3 = Theme.colors.success })
	return root
end

function Screens.codes(parent: Instance, context: any): Frame
	local root, content = base(parent, "Likes & Codes", context.close)
	local likes = context.state.likes
	row(
		content,
		`Likes: {UIFactory.formatNumber(likes.value or 0)}`,
		likes.reason or "Thanks for supporting the experience!",
		"likes"
	)
	for _, milestone in context.state.likesMilestones do
		local unlocked = (likes.value or 0) >= milestone.likes
		local detail = if unlocked
			then `{milestone.label} - Code: {milestone.code}`
			else `{milestone.label} - Locked`
		row(content, `{milestone.likes} Likes`, detail, "codes")
	end
	local input = UIFactory.textBox(content, "Enter code")
	UIFactory.button(content, "REDEEM CODE", function()
		context.request("RedeemCode", { code = input.Text })
	end)
	return root
end

local function leaderboardRows(content: Instance, rows: { any })
	for index, entry in rows do
		row(
			content,
			`#{entry.rank or index}  {entry.name}`,
			`{UIFactory.formatNumber(entry.value)} Coins`,
			"leaderboard"
		)
	end
	if #rows == 0 then
		row(content, "No players yet", "Leaderboard data appears after profiles load.", "friends")
	end
end

function Screens.leaderboards(parent: Instance, context: any): Frame
	local root, content = base(parent, "Top Players", context.close)
	UIFactory.label(content, "CURRENT SERVER", { Size = UDim2.new(1, -8, 0, 32), FontFace = Theme.fontBold })
	leaderboardRows(content, context.state.serverLeaderboard)
	UIFactory.button(content, "SHOW GLOBAL TOP 50", function()
		task.spawn(function()
			local response = context.query("GlobalLeaderboard", {})
			if response.ok and response.data then
				context.showList("Global Leaderboard", response.data)
			else
				context.toast(response.message or "Global leaderboard unavailable")
			end
		end)
	end)
	return root
end

function Screens.verification(parent: Instance, context: any): Frame
	local root, content = base(parent, "Community", context.close)
	local availability = context.state.integrationAvailability
	row(
		content,
		"Roblox Community",
		if availability.community
			then "Community rewards are ready!"
			else "Community rewards are coming soon.",
		"verification"
	)
	row(
		content,
		"Clubs",
		if availability.guilds then "Clubs are ready!" else "Team up with friends when clubs arrive later.",
		"community"
	)
	return root
end

function Screens.simpleList(parent: Instance, context: any, title: string, rows: { any }): Frame
	local root, content = base(parent, title, context.close)
	leaderboardRows(content, rows)
	return root
end

return Screens
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">UIComponent</string>
              <string name="Source"><![CDATA[--!strict

export type Handle = {
	root: GuiObject,
	setVisible: (boolean) -> (),
	destroy: () -> (),
}

local UIComponent = {}

function UIComponent.mount(parent: Instance, builder: (Instance) -> GuiObject): Handle
	local root = builder(parent)
	return {
		root = root,
		setVisible = function(visible: boolean)
			root.Visible = visible
		end,
		destroy = function()
			root:Destroy()
		end,
	}
end

return UIComponent
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">UIFactory</string>
              <string name="Source"><![CDATA[--!strict

local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")

local Theme =
	require(game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").Theme)

local UIFactory = {}

local function hoverTweenInfo(): TweenInfo
	return TweenInfo.new(if GuiService.ReducedMotionEnabled then 0 else 0.12)
end

local function authoredTemplate(parent: Instance, name: string): Instance?
	local screenGui = parent:FindFirstAncestorWhichIsA("ScreenGui")
	if not screenGui then
		return nil
	end
	local root = screenGui:FindFirstChild("Root")
	local templates = if root then root:FindFirstChild("ComponentTemplates") else nil
	return if templates then templates:FindFirstChild(name) else nil
end

local function corner(parent: Instance, radius: UDim?)
	local object = Instance.new("UICorner")
	object.CornerRadius = radius or Theme.radius.medium
	object.Parent = parent
end

local function stroke(parent: Instance, transparency: number?)
	local object = Instance.new("UIStroke")
	object.Color = Theme.colors.stroke
	object.Transparency = transparency or 0.45
	object.Thickness = 1.5
	object.Parent = parent
end

local function padding(parent: Instance, value: number)
	local object = Instance.new("UIPadding")
	object.PaddingTop = UDim.new(0, value)
	object.PaddingBottom = UDim.new(0, value)
	object.PaddingLeft = UDim.new(0, value)
	object.PaddingRight = UDim.new(0, value)
	object.Parent = parent
end

function UIFactory.frame(parent: Instance, name: string, properties: any?): Frame
	local object = Instance.new("Frame")
	object.Name = name
	object.BorderSizePixel = 0
	object.BackgroundColor3 = Theme.colors.surface
	if properties then
		for key, value in properties do
			(object :: any)[key] = value
		end
	end
	object.Parent = parent
	return object
end

function UIFactory.card(parent: Instance, name: string, properties: any?): Frame
	local object = UIFactory.frame(parent, name, properties)
	corner(object)
	stroke(object)
	return object
end

function UIFactory.label(parent: Instance, text: string, properties: any?): TextLabel
	local template = authoredTemplate(parent, "LabelTemplate")
	local object = if template and template:IsA("TextLabel")
		then template:Clone()
		else Instance.new("TextLabel")
	if not template then
		object.BackgroundTransparency = 1
		object.BorderSizePixel = 0
		object.FontFace = Theme.font
		object.TextColor3 = Theme.colors.text
		object.TextSize = 18
		object.TextWrapped = true
		object.TextXAlignment = Enum.TextXAlignment.Left
	end
	object.Visible = true
	object.Text = text
	if properties then
		for key, value in properties do
			(object :: any)[key] = value
		end
	end
	object.Parent = parent
	return object
end

function UIFactory.button(
	parent: Instance,
	text: string,
	onActivated: (() -> ())?,
	properties: any?
): TextButton
	local template = authoredTemplate(parent, "ButtonTemplate")
	local object = if template and template:IsA("TextButton")
		then template:Clone()
		else Instance.new("TextButton")
	if not template then
		object.AutoButtonColor = false
		object.BackgroundColor3 = Theme.colors.primary
		object.BorderSizePixel = 0
		object.FontFace = Theme.fontBold
		object.TextColor3 = Theme.colors.text
		object.TextSize = 16
		object.TextWrapped = true
		object.Selectable = true
		object.Size = UDim2.new(1, 0, 0, Theme.touchTarget)
		corner(object, Theme.radius.small)
		stroke(object, 0.7)
	end
	object.Visible = true
	object.Text = text
	if properties then
		for key, value in properties do
			(object :: any)[key] = value
		end
	end
	local restingColor = object.BackgroundColor3
	object.MouseEnter:Connect(function()
		TweenService:Create(object, hoverTweenInfo(), { BackgroundColor3 = Theme.colors.primaryHover }):Play()
	end)
	object.MouseLeave:Connect(function()
		TweenService:Create(object, hoverTweenInfo(), { BackgroundColor3 = restingColor }):Play()
	end)
	if onActivated then
		object.Activated:Connect(onActivated)
	end
	object.Parent = parent
	return object
end

function UIFactory.textBox(parent: Instance, placeholder: string, properties: any?): TextBox
	local template = authoredTemplate(parent, "TextBoxTemplate")
	local object = if template and template:IsA("TextBox") then template:Clone() else Instance.new("TextBox")
	if not template then
		object.BackgroundColor3 = Theme.colors.background
		object.BorderSizePixel = 0
		object.ClearTextOnFocus = false
		object.FontFace = Theme.font
		object.PlaceholderColor3 = Theme.colors.textMuted
		object.TextColor3 = Theme.colors.text
		object.TextSize = 16
		object.TextWrapped = true
		object.Size = UDim2.new(1, 0, 0, Theme.touchTarget)
		corner(object, Theme.radius.small)
		stroke(object)
		padding(object, Theme.spacing.sm)
	end
	object.Visible = true
	object.PlaceholderText = placeholder
	object.Text = ""
	if properties then
		for key, value in properties do
			(object :: any)[key] = value
		end
	end
	object.Parent = parent
	return object
end

function UIFactory.list(parent: Instance, paddingPixels: number?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, paddingPixels or Theme.spacing.sm)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = parent
	return layout
end

function UIFactory.scroll(parent: Instance, name: string, properties: any?): ScrollingFrame
	local object = Instance.new("ScrollingFrame")
	object.Name = name
	object.BackgroundTransparency = 1
	object.BorderSizePixel = 0
	object.AutomaticCanvasSize = Enum.AutomaticSize.Y
	object.CanvasSize = UDim2.new()
	object.ScrollBarThickness = 6
	object.ScrollBarImageColor3 = Theme.colors.primary
	if properties then
		for key, value in properties do
			(object :: any)[key] = value
		end
	end
	object.Parent = parent
	return object
end

function UIFactory.addPadding(parent: Instance, value: number)
	padding(parent, value)
end

function UIFactory.addCorner(parent: Instance, radius: UDim?)
	corner(parent, radius)
end

function UIFactory.formatNumber(value: number): string
	local suffixes = { "", "K", "M", "B", "T", "Qa" }
	local absolute = math.abs(value)
	local index = 1
	while absolute >= 1000 and index < #suffixes do
		absolute /= 1000
		value /= 1000
		index += 1
	end
	if index == 1 then
		return tostring(math.floor(value))
	end
	return `{string.format("%.1f", value)}{suffixes[index]}`
end

return UIFactory
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">UIStyles</string>
              <string name="Source"><![CDATA[--!strict

local Theme =
	require(game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").Theme)

local UIStyles = {}

function UIStyles.install(screenGui: ScreenGui)
	local sheet = Instance.new("StyleSheet")
	sheet.Name = "TemplateTokens"
	for name, value in Theme.colors do
		sheet:SetAttribute(name, value)
	end
	sheet:SetAttribute("TouchTarget", Theme.touchTarget)
	sheet.Parent = screenGui

	local link = Instance.new("StyleLink")
	link.StyleSheet = sheet
	link.Parent = screenGui
end

return UIStyles
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
