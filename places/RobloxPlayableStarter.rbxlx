  <Item class="ServerScriptService" referent="21">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">PlayableStarter</string>
      </Properties>
      <Item class="Script" referent="23">
        <Properties>
          <string name="Name">StarterExample</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict

local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Template"):WaitForChild("Shared").TemplateConfig)
local EconomyService = require(ServerScriptService:WaitForChild("TemplateServer").Services.EconomyService)

local lastAwardAt: { [Player]: { [string]: number } } = {}

local function bindPad(padName: string, promptName: string): (BasePart, ProximityPrompt)
	local pad = Workspace:WaitForChild(padName)
	assert(pad:IsA("BasePart"), `Workspace.{padName} must be an authored BasePart`)
	local prompt = pad:WaitForChild(promptName)
	assert(prompt:IsA("ProximityPrompt"), `{padName}.{promptName} must be an authored ProximityPrompt`)
	return pad, prompt
end

-- A place saved before an authored object existed must not park this script
-- (and every binding after it) on WaitForChild forever.
local function findPad(padName: string, promptName: string): (BasePart?, ProximityPrompt?)
	local pad = Workspace:WaitForChild(padName, 10)
	if pad == nil or not pad:IsA("BasePart") then
		return nil, nil
	end
	local prompt = pad:WaitForChild(promptName, 10)
	if prompt == nil or not prompt:IsA("ProximityPrompt") then
		return nil, nil
	end
	return pad, prompt
end

local function allowAward(player: Player, padKey: string): boolean
	local now = os.clock()
	local perPad = lastAwardAt[player]
	if perPad == nil then
		perPad = {}
		lastAwardAt[player] = perPad
	end
	if now - (perPad[padKey] or 0) < 1 then
		return false
	end
	perPad[padKey] = now
	return true
end

Players.PlayerRemoving:Connect(function(player)
	lastAwardAt[player] = nil
end)

local _, earnPrompt = bindPad("ExampleEarningPad", "EarnPrompt")
earnPrompt.ActionText = `Earn 10 {Config.economy.primaryCurrency}`
earnPrompt.ObjectText = `{Config.economy.primaryCurrency} Trainer`
earnPrompt.Triggered:Connect(function(player)
	if allowAward(player, "primary") then
		EconomyService.award(player, 10, "starter:earning-pad")
	end
end)

-- The bonus pad makes a multi-currency recipe provable in Play mode: it pays
-- the second configured currency directly (no earnings multiplier; that bonus
-- only applies to the primary currency). Single-currency recipes hide it.
local bonusPad, bonusPrompt = findPad("BonusEarningPad", "BonusPrompt")
if bonusPad == nil or bonusPrompt == nil then
	warn(
		"Workspace.BonusEarningPad is missing; rebuild the place from bootstrap.project.json to demo a second currency"
	)
elseif #Config.economy.currencies >= 2 then
	local bonusCurrency = Config.economy.currencies[2]
	bonusPrompt.ActionText = `Earn 5 {bonusCurrency.name}`
	bonusPrompt.ObjectText = `{bonusCurrency.name} Trainer`
	bonusPrompt.Triggered:Connect(function(player)
		if allowAward(player, "bonus") then
			EconomyService.awardCurrencyRaw(player, bonusCurrency.id, 5, "starter:bonus-pad")
		end
	end)
else
	bonusPrompt.Enabled = false
	bonusPad.Transparency = 1
	bonusPad.CanCollide = false
	bonusPad.CanQuery = false
	bonusPad.CanTouch = false
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="24">
      <Properties>
        <string name="Name">TemplateServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Template"):WaitForChild("Shared").TemplateConfig)

local Services = script.Services
local AnnouncementService = require(Services.AnnouncementService)
local FeedbackService = require(Services.FeedbackService)
local LeaderboardService = require(Services.LeaderboardService)
local NotificationService = require(Services.NotificationService)
local ProfileService = require(Services.ProfileService)
local PublicProfileService = require(Services.PublicProfileService)
local RemoteService = require(Services.RemoteService)
local RewardService = require(Services.RewardService)
local SocialService = require(Services.SocialService)
local StoreService = require(Services.StoreService)
local EconomyRateProvider = require(script.Providers.DefaultEconomyRateProvider)

RemoteService.initialize()
if Config.features.store then
	StoreService.initialize()
end
ProfileService.startAutosave()
if Config.features.leaderboards then
	LeaderboardService.start()
end
if Config.features.crossServerChat then
	AnnouncementService.start(RemoteService.broadcastAnnouncement)
end

local function playerAdded(player: Player)
	task.spawn(function()
		local profile = ProfileService.load(player)
		if profile == nil then
			if player.Parent then
				player:Kick("Your data could not be loaded safely. Please rejoin.")
			end
			return
		end
		NotificationService.cancel(player)
		StoreService.refreshEntitlements(player)
		SocialService.refresh(player)
		player:GetPropertyChangedSignal("MembershipType"):Connect(function()
			SocialService.refresh(player)
		end)
		if Config.features.offlineEarnings then
			RewardService.prepareOffline(player)
		end
		if Config.features.leaderboards then
			LeaderboardService.updateLeaderstats(player)
		end
		if Config.features.profiles then
			PublicProfileService.publish(player)
		end
		RemoteService.publish(player)
		SocialService.refreshAll()
	end)
end

local function playerRemoving(player: Player)
	if Config.features.notifications then
		NotificationService.scheduleOnLeave(player)
	end
	if Config.features.profiles then
		PublicProfileService.publish(player)
	end
	if Config.features.leaderboards then
		LeaderboardService.flushPlayer(player)
	end
	RewardService.forget(player)
	FeedbackService.forget(player)
	RemoteService.forget(player)
	ProfileService.release(player)
	task.defer(SocialService.refreshAll)
end

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(playerRemoving)
for _, player in Players:GetPlayers() do
	playerAdded(player)
end

task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			local profile = ProfileService.get(player)
			if profile then
				profile.stats.playSeconds += 60
				profile.lastSeenAt = os.time()
				profile.offlineRateSnapshot = EconomyRateProvider.getRate(player)
				ProfileService.markDirty(player, "playtime")
				if Config.features.profiles then
					PublicProfileService.publish(player)
				end
			end
		end
	end
end)

game:BindToClose(function()
	ProfileService.close()
end)
]]></string>
      </Properties>
      <Item class="Folder" referent="25">
        <Properties>
          <string name="Name">Providers</string>
        </Properties>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">CommunityVerificationProvider</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(
	game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").TemplateConfig
)

local Provider = {}

function Provider.verify(player: Player): { status: string, value: boolean?, reason: string? }
	if not Config.features.communityVerification or Config.identity.communityId <= 0 then
		return { status = "disabled", value = false, reason = "Community ID is not configured" }
	end
	local success, verified = pcall(function()
		return player:IsInGroupAsync(Config.identity.communityId)
	end)
	if not success then
		return { status = "error", value = false, reason = "Roblox community lookup failed" }
	end
	return { status = "available", value = verified }
end

return Provider
]]></string>
          </Properties>
        </Item>
