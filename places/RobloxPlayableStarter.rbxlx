        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">MigrationCore</string>
            <string name="Source"><![CDATA[--!strict

local MigrationCore = {}

function MigrationCore.deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local result = {}
	for key, child in value do
		result[MigrationCore.deepCopy(key)] = MigrationCore.deepCopy(child)
	end
	return result
end

function MigrationCore.reconcile(target: any, defaults: any)
	for key, value in defaults do
		if target[key] == nil then
			target[key] = MigrationCore.deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" then
			MigrationCore.reconcile(target[key], value)
		end
	end
end

function MigrationCore.migrate(raw: any, defaults: any, currentVersion: number): any
	local profile = if type(raw) == "table"
		then MigrationCore.deepCopy(raw)
		else MigrationCore.deepCopy(defaults)
	MigrationCore.reconcile(profile, defaults)
	profile.schemaVersion = currentVersion
	return profile
end

return MigrationCore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Migrations</string>
            <string name="Source"><![CDATA[--!strict

local CurrencyConfig = require(script.Parent.CurrencyConfig)
local ProfileTemplate = require(script.Parent.ProfileTemplate)
local MigrationCore = require(script.Parent.MigrationCore)
local Config = require(script.Parent.TemplateConfig)

local Migrations = {}
Migrations.CURRENT_VERSION = 2

function Migrations.migrate(raw: any, now: number): any
	local previousVersion = if type(raw) == "table" and type(raw.schemaVersion) == "number"
		then raw.schemaVersion
		else 0
	local profile = MigrationCore.migrate(raw, ProfileTemplate.create(now), Migrations.CURRENT_VERSION)
	CurrencyConfig.reconcileProfileCurrencies(
		profile,
		Config.economy.currencies,
		Config.economy.primaryCurrencyId,
		previousVersion
	)
	return profile
end

return Migrations
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">ProfileTemplate</string>
            <string name="Source"><![CDATA[--!strict

local CurrencyConfig = require(script.Parent.CurrencyConfig)
local Config = require(script.Parent.TemplateConfig)
local Types = require(script.Parent.Types)
type PlayerProfileV1 = Types.PlayerProfileV1

local ProfileTemplate = {}

function ProfileTemplate.create(now: number): PlayerProfileV1
	local currencies = CurrencyConfig.startingBalances(Config.economy.currencies)
	return {
		schemaVersion = 2,
		coins = currencies[Config.economy.primaryCurrencyId] or 0,
		currencies = currencies,
		inventory = {
			double_coins_potion = { quantity = 1 },
		},
		boosts = {},
		settings = {
			musicVolume = 0.5,
			sfxVolume = 0.7,
			uiScale = 1,
			reducedMotion = false,
			announcements = true,
			afKRollOver = true,
			notifications = false,
		},
		stats = {
			playSeconds = 0,
			joins = 0,
			totalCoinsEarned = 0,
		},
		daily = {
			lastClaimDay = -1,
			streak = 0,
		},
		redemptions = {},
		entitlements = {
			extendedOffline = false,
			premium = false,
		},
		social = {
			friendCountInServer = 0,
			communityVerified = false,
			discordVerified = false,
		},
		guild = {},
		lastSeenAt = now,
		offlineRateSnapshot = 0,
		createdAt = now,
		updatedAt = now,
	}
end

return ProfileTemplate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Providers</string>
            <string name="Source"><![CDATA[--!strict

export type EconomyRateProvider = {
	getRate: (player: Player) -> number,
}

export type LikesProvider = {
	getLikes: () -> { status: string, value: number?, reason: string? },
}

export type VerificationProvider = {
	verify: (player: Player) -> { status: string, value: boolean?, reason: string? },
}

export type NotificationScheduler = {
	schedule: (userId: number, kind: string, dueAt: number) -> { status: string, reason: string? },
	cancel: (userId: number) -> (),
}

export type PublicProfileProvider = {
	findByUserId: (userId: number) -> any,
}

return {}
]]></string>
          </Properties>
