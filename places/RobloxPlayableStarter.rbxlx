        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">AnnouncementService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)

local AnnouncementService = {}

function AnnouncementService.start(broadcast: (string) -> ())
	task.spawn(function()
		local index = 0
		while true do
			task.wait(Config.announcements.intervalSeconds)
			index = (index % #Config.announcements.messages) + 1
			broadcast(Config.announcements.messages[index])
		end
	end)
end

return AnnouncementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local Calculations = require(Shared.Calculations)
local ProfileService = require(script.Parent.ProfileService)

local EconomyService = {}

function EconomyService.getMultiplier(player: Player): number
	local profile = ProfileService.get(player)
	if profile == nil then
		return 1
	end
	return Calculations.earningsMultiplier(
		profile.social.friendCountInServer,
		profile.entitlements.premium,
		profile.boosts,
		os.time(),
		Config.economy.friendBonusPerFriend,
		Config.economy.friendBonusCap,
		Config.economy.premiumBonus
	)
end

function EconomyService.awardRaw(player: Player, amount: number, source: string): (boolean, number)
	local profile = ProfileService.get(player)
	if profile == nil or amount ~= amount or amount <= 0 or amount == math.huge then
		return false, 0
	end
	local granted = math.floor(math.min(amount, 1e12))
	profile.coins = math.min(profile.coins + granted, 9e15)
	profile.stats.totalCoinsEarned = math.min(profile.stats.totalCoinsEarned + granted, 9e15)
	ProfileService.markDirty(player, `award:{source}`)
	return true, granted
end

function EconomyService.award(player: Player, baseAmount: number, source: string): (boolean, number)
	return EconomyService.awardRaw(player, baseAmount * EconomyService.getMultiplier(player), source)
end

function EconomyService.spend(player: Player, amount: number, source: string): boolean
	local profile = ProfileService.get(player)
	if profile == nil or amount ~= amount or amount <= 0 or amount == math.huge then
		return false
	end
	local cost = math.floor(amount)
	if profile.coins < cost then
		return false
	end
	profile.coins -= cost
	ProfileService.markDirty(player, `spend:{source}`)
	return true
end

function EconomyService.permanentOfflineMultiplier(player: Player): number
	local profile = ProfileService.get(player)
	if profile == nil then
		return 1
	end
	return 1 + (if profile.entitlements.premium then Config.economy.premiumBonus else 0)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">FeedbackService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)

local FeedbackService = {}
local store: GlobalDataStore? = nil
local lastSubmittedAt: { [Player]: number } = {}
local allowedCategories = { Bug = true, Feedback = true, Accessibility = true, Other = true }

local function getStore(): GlobalDataStore
	local current = store
	if current == nil then
		current = DataStoreService:GetDataStore(Config.feedbackStoreName)
		store = current
	end
	return current
end

function FeedbackService.submit(player: Player, category: any, message: any): (boolean, string)
	if type(category) ~= "string" or not allowedCategories[category] then
		return false, "Choose a valid category"
	end
	if type(message) ~= "string" or #message < 3 or #message > Config.feedback.maxLength then
		return false, `Feedback must be 3-{Config.feedback.maxLength} characters`
	end
	local now = os.time()
	if now - (lastSubmittedAt[player] or 0) < Config.feedback.cooldownSeconds then
		return false, "Please wait before submitting again"
	end

	local filtered = ""
	local isMock = RunService:IsStudio() and not Config.studio.useLiveDataStore
	local filterSuccess = true
	if isMock then
		filtered = string.sub(message, 1, Config.feedback.maxLength)
	else
		filterSuccess = pcall(function()
			local result =
				TextService:FilterStringAsync(message, player.UserId, Enum.TextFilterContext.PrivateChat)
			filtered = result:GetNonChatStringForBroadcastAsync()
		end)
	end
	if not filterSuccess or filtered == "" then
		return false, "Feedback could not be filtered"
	end

	local record = {
		category = category,
		message = filtered,
		userId = player.UserId,
		placeId = game.PlaceId,
		jobId = game.JobId,
		templateVersion = Config.version,
		createdAt = now,
	}
	local success = true
	if isMock then
		print("[Template feedback mock]", record)
	else
		success = pcall(function()
			getStore():SetAsync(`report:{now}:{HttpService:GenerateGUID(false)}`, record)
		end)
	end
	if not success then
		return false, "Feedback storage is temporarily unavailable"
	end
	lastSubmittedAt[player] = now
	return true, "Thanks—your report was stored"
end

function FeedbackService.forget(player: Player)
	lastSubmittedAt[player] = nil
end

return FeedbackService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Catalogs = require(Shared.Catalogs)
local ProfileService = require(script.Parent.ProfileService)
local EconomyService = require(script.Parent.EconomyService)

local InventoryService = {}

function InventoryService.grant(player: Player, itemId: string, quantity: number): boolean
	local profile = ProfileService.get(player)
	local definition = Catalogs.items[itemId]
	if profile == nil or definition == nil or quantity < 1 then
		return false
	end
	local entry = profile.inventory[itemId] or { quantity = 0 }
	entry.quantity = math.clamp(entry.quantity + math.floor(quantity), 0, definition.maxStack)
	profile.inventory[itemId] = entry
	ProfileService.markDirty(player, `inventory:grant:{itemId}`)
	return true
end

function InventoryService.buy(player: Player, itemId: string): (boolean, string)
	local definition = Catalogs.items[itemId]
	if definition == nil or definition.priceCoins == nil then
		return false, "Item is unavailable"
	end
	local profile = ProfileService.get(player)
	if profile == nil then
		return false, "Profile is not loaded"
	end
	local entry = profile.inventory[itemId]
	if entry and entry.quantity >= definition.maxStack then
		return false, "Inventory stack is full"
	end
	if not EconomyService.spend(player, definition.priceCoins, `shop:{itemId}`) then
		return false, "Not enough Coins"
	end
	InventoryService.grant(player, itemId, 1)
	return true, `Purchased {definition.name}`
end

function InventoryService.consume(player: Player, itemId: string): (boolean, string)
	local profile = ProfileService.get(player)
	local definition = Catalogs.items[itemId]
	local entry = if profile then profile.inventory[itemId] else nil
	if profile == nil or definition == nil or entry == nil or entry.quantity < 1 then
		return false, "Item is unavailable"
	end
	if
		definition.category ~= "Consumable"
		or definition.boostMultiplier == nil
		or definition.boostDurationSeconds == nil
	then
		return false, "Item cannot be consumed"
	end

	entry.quantity -= 1
	local now = os.time()
	local found = false
	for _, boost in profile.boosts do
		if boost.id == itemId then
			boost.expiresAt = math.max(boost.expiresAt, now) + definition.boostDurationSeconds
			boost.multiplier = definition.boostMultiplier
			found = true
			break
		end
	end
	if not found then
		table.insert(profile.boosts, {
			id = itemId,
			expiresAt = now + definition.boostDurationSeconds,
			multiplier = definition.boostMultiplier,
		})
	end
	ProfileService.markDirty(player, `inventory:consume:{itemId}`)
	return true, `Activated {definition.name}`
end

function InventoryService.toggleEquip(player: Player, itemId: string): (boolean, string)
	local profile = ProfileService.get(player)
	local definition = Catalogs.items[itemId]
	local entry = if profile then profile.inventory[itemId] else nil
	if profile == nil or definition == nil or entry == nil or entry.quantity < 1 then
		return false, "Item is unavailable"
	end
	if definition.category ~= "Equipment" then
		return false, "Item is not equipment"
	end
	entry.equipped = not entry.equipped
	ProfileService.markDirty(player, `inventory:equip:{itemId}`)
	return true, if entry.equipped then "Equipped" else "Unequipped"
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local ProfileService = require(script.Parent.ProfileService)

local LeaderboardService = {}
local store: OrderedDataStore? = nil
local nameCache: { [number]: string } = {}

local function getStore(): OrderedDataStore
	local current = store
	if current == nil then
		current = DataStoreService:GetOrderedDataStore(Config.leaderboardStoreName)
		store = current
	end
	return current
end

local function displayName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local success, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = if success then name else `User {userId}`
	nameCache[userId] = result
	return result
end

function LeaderboardService.updateLeaderstats(player: Player)
	local profile = ProfileService.get(player)
	if profile == nil then
		return
	end
	local folder = player:FindFirstChild("leaderstats") :: Folder?
	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end
	local coins = folder:FindFirstChild("Coins") :: IntValue?
	if coins == nil then
		coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Parent = folder
	end
	coins.Value = math.clamp(math.floor(profile.coins), 0, 2147483647)
end

function LeaderboardService.serverBoard(): { any }
	local rows = {}
	for _, player in Players:GetPlayers() do
		local profile = ProfileService.get(player)
		if profile then
			table.insert(rows, { userId = player.UserId, name = player.DisplayName, value = profile.coins })
		end
	end
	table.sort(rows, function(a, b)
		return a.value > b.value
	end)
	return rows
end

function LeaderboardService.globalBoard(): (boolean, { any } | string)
	if RunService:IsStudio() and not Config.studio.useLiveDataStore then
		return true, LeaderboardService.serverBoard()
	end
	local success, result = pcall(function()
		local pages = getStore():GetSortedAsync(false, Config.leaderboards.globalSize)
		local rows = {}
		for rank, entry in pages:GetCurrentPage() do
			local userId = tonumber(entry.key) or 0
			table.insert(
				rows,
				{ rank = rank, userId = userId, name = displayName(userId), value = entry.value }
			)
		end
		return rows
	end)
	return success, if success then result else "Global leaderboard is unavailable"
end

function LeaderboardService.flushPlayer(player: Player)
	local profile = ProfileService.get(player)
	if profile == nil or (RunService:IsStudio() and not Config.studio.useLiveDataStore) then
		return
	end
	pcall(function()
		getStore():SetAsync(tostring(player.UserId), math.floor(profile.coins))
	end)
end

function LeaderboardService.start()
	task.spawn(function()
		while true do
			task.wait(Config.leaderboards.refreshSeconds)
			for _, player in Players:GetPlayers() do
				LeaderboardService.updateLeaderstats(player)
				LeaderboardService.flushPlayer(player)
			end
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">LikesService</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)

local LikesService = {}
local lastKnown = Config.rewards.manualLikes
local updatedAt = 0

function LikesService.getLikes(): { status: string, value: number?, reason: string? }
	if os.time() - updatedAt < Config.rewards.likesRefreshSeconds then
		return { status = "available", value = lastKnown }
	end
	updatedAt = os.time()
	if Config.identity.universeId <= 0 or not HttpService.HttpEnabled then
		return { status = "disabled", value = lastKnown, reason = "Using the configured preview count" }
	end

	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = `https://games.roblox.com/v1/games/votes?universeIds={Config.identity.universeId}`,
			Method = "GET",
		})
	end)
	if success and response.Success then
		local decoded = HttpService:JSONDecode(response.Body)
		local first = decoded.data and decoded.data[1]
		if first and type(first.upVotes) == "number" then
			lastKnown = first.upVotes
			return { status = "available", value = lastKnown }
		end
	end
	return { status = "error", value = lastKnown, reason = "Showing the last known likes count" }
end

return LikesService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">NotificationService</string>
            <string name="Source"><![CDATA[--!strict

local HttpService = game:GetService("HttpService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local ProfileService = require(script.Parent.ProfileService)

local NotificationService = {}

local function request(path: string, body: any): boolean
	if Config.notifications.workerUrl == "" or not HttpService.HttpEnabled then
		return false
	end
	local success = pcall(function()
		local secret = HttpService:GetSecret("NotificationWorkerSecret")
		local headers: any = { Authorization = secret:AddPrefix("Bearer ") }
		local response = HttpService:RequestAsync({
			Url = Config.notifications.workerUrl .. path,
			Method = "POST",
			Headers = headers,
			Body = HttpService:JSONEncode(body),
		})
		if not response.Success then
			error(`Worker returned {response.StatusCode}`)
		end
	end)
	return success
end

function NotificationService.scheduleOnLeave(player: Player)
	local profile = ProfileService.get(player)
	if profile == nil or not profile.settings.notifications then
		return
	end
	local now = os.time()
	local nextDay = (math.floor(now / 86400) + 1) * 86400 + 9 * 3600
	if Config.notifications.dailyMessageId ~= "" then
		request("/v1/jobs", {
			userId = player.UserId,
			kind = "daily",
			dueAt = nextDay,
			messageId = Config.notifications.dailyMessageId,
			launchData = "daily",
		})
	end
	if Config.notifications.offlineMessageId ~= "" then
		request("/v1/jobs", {
			userId = player.UserId,
			kind = "offline",
			dueAt = now + Config.economy.freeOfflineCapHours * 3600,
			messageId = Config.notifications.offlineMessageId,
			launchData = "offline",
		})
	end
end

function NotificationService.cancel(player: Player)
	request("/v1/cancel", { userId = player.UserId })
end

return NotificationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local Migrations = require(Shared.Migrations)
local ProfileTemplate = require(Shared.ProfileTemplate)
local Types = require(Shared.Types)
local SessionLock = require(script.Parent.Parent.Util.SessionLock)

type PlayerProfileV1 = Types.PlayerProfileV1
type Envelope = {
	data: PlayerProfileV1,
	lock: SessionLock.Lock?,
	updatedAt: number,
}

local ProfileService = {}
local profiles: { [Player]: PlayerProfileV1 } = {}
local dirty: { [Player]: boolean } = {}
local mockProfiles: { [number]: PlayerProfileV1 } = {}
local changedEvent = Instance.new("BindableEvent")
local store: GlobalDataStore? = nil
local lockTimeoutSeconds = 180
local autosaveSeconds = 60
local closing = false

ProfileService.changed = changedEvent.Event

local function copy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local output = {}
	for key, child in value do
		output[copy(key)] = copy(child)
	end
	return output
end

local function keyFor(player: Player): string
	return `player:{player.UserId}`
end

local function shouldMock(): boolean
	return RunService:IsStudio() and not Config.studio.useLiveDataStore
end

local function getStore(): GlobalDataStore
	local current = store
	if current == nil then
		current = DataStoreService:GetDataStore(Config.profileStoreName)
		store = current
	end
	return current
end

local function updateEnvelope(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if profile == nil then
		return false
	end
	profile.updatedAt = os.time()

	if shouldMock() then
		mockProfiles[player.UserId] = copy(profile)
		return true
	end

	local success, result = pcall(function()
		return getStore():UpdateAsync(keyFor(player), function(old: Envelope?): Envelope?
			if old == nil or old.lock == nil or old.lock.jobId ~= game.JobId then
				return nil
			end
			return {
				data = copy(profile),
				lock = if release then nil else SessionLock.claim(game.JobId, game.PlaceId, os.time()),
				updatedAt = os.time(),
			}
		end)
	end)
	if not success or result == nil then
		return false
	end
	return release or (result.lock ~= nil and result.lock.jobId == game.JobId)
end

function ProfileService.load(player: Player): PlayerProfileV1?
	if profiles[player] ~= nil then
		return profiles[player]
	end

	local now = os.time()
	local loaded: PlayerProfileV1? = nil
	if shouldMock() then
		loaded = Migrations.migrate(mockProfiles[player.UserId] or ProfileTemplate.create(now), now)
		if loaded then
			loaded.coins = math.max(loaded.coins, Config.studio.mockStartingCoins)
		end
	else
		for attempt = 1, 5 do
			local attemptNow = os.time()
			local success, result = pcall(function()
				return getStore():UpdateAsync(keyFor(player), function(old: Envelope?): Envelope?
					local envelope = old
					if envelope == nil then
						envelope = {
							data = ProfileTemplate.create(now),
							lock = nil,
							updatedAt = now,
						}
					end
					if
						not SessionLock.canClaim(envelope.lock, game.JobId, attemptNow, lockTimeoutSeconds)
					then
						return nil
					end
					envelope.data = Migrations.migrate(envelope.data, now)
					envelope.lock = SessionLock.claim(game.JobId, game.PlaceId, attemptNow)
					envelope.updatedAt = attemptNow
					return envelope
				end)
			end)
			if success and result ~= nil and result.lock ~= nil and result.lock.jobId == game.JobId then
				loaded = result.data
				break
			end
			task.wait(math.min(2 ^ attempt, 8))
		end
	end

	if loaded == nil or player.Parent == nil then
		return nil
	end
	loaded.stats.joins += 1
	loaded.updatedAt = now
	profiles[player] = loaded
	dirty[player] = true
	changedEvent:Fire(player, "loaded")
	return loaded
end

function ProfileService.get(player: Player): PlayerProfileV1?
	return profiles[player]
end

function ProfileService.snapshot(player: Player): PlayerProfileV1?
	local profile = profiles[player]
	return if profile then copy(profile) else nil
end

function ProfileService.markDirty(player: Player, reason: string?)
	if profiles[player] == nil then
		return
	end
	dirty[player] = true
	changedEvent:Fire(player, reason or "updated")
end

function ProfileService.save(player: Player): boolean
	if not dirty[player] then
		return true
	end
	local success = updateEnvelope(player, false)
	if success then
		dirty[player] = nil
	end
	return success
end

function ProfileService.release(player: Player)
	local profile = profiles[player]
	if profile == nil then
		return
	end
	profile.lastSeenAt = os.time()
	profile.updatedAt = os.time()
	updateEnvelope(player, true)
	profiles[player] = nil
	dirty[player] = nil
end

function ProfileService.startAutosave()
	task.spawn(function()
		while not closing do
			task.wait(autosaveSeconds)
			for player in profiles do
				ProfileService.save(player)
			end
		end
	end)
end

function ProfileService.close()
	closing = true
	local threads = 0
	for player in profiles do
		threads += 1
		task.spawn(function()
			ProfileService.release(player)
			threads -= 1
		end)
	end
	local deadline = os.clock() + 25
	while threads > 0 and os.clock() < deadline do
		task.wait()
	end
end

return ProfileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">PublicProfileService</string>
            <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local Types = require(Shared.Types)
local ProfileService = require(script.Parent.ProfileService)

type PublicProfile = Types.PublicProfile

local PublicProfileService = {}
local store: GlobalDataStore? = nil
local mock: { [number]: PublicProfile } = {}

local function getStore(): GlobalDataStore
	local current = store
	if current == nil then
		current = DataStoreService:GetDataStore(Config.publicProfileStoreName)
		store = current
	end
	return current
end

local function key(userId: number): string
	return `user:{userId}`
end

function PublicProfileService.fromPlayer(player: Player): PublicProfile?
	local profile = ProfileService.get(player)
	if profile == nil then
		return nil
	end
	return {
		userId = player.UserId,
		username = player.Name,
		displayName = player.DisplayName,
		coins = profile.coins,
		joins = profile.stats.joins,
		playSeconds = profile.stats.playSeconds,
		dailyStreak = profile.daily.streak,
		updatedAt = os.time(),
	}
end

function PublicProfileService.publish(player: Player)
	local public = PublicProfileService.fromPlayer(player)
	if public == nil then
		return
	end
	if RunService:IsStudio() and not Config.studio.useLiveDataStore then
		mock[player.UserId] = public
		return
	end
	pcall(function()
		getStore():SetAsync(key(player.UserId), public)
	end)
end

function PublicProfileService.find(rawUsername: any): (boolean, PublicProfile? | string)
	if type(rawUsername) ~= "string" or #rawUsername < 3 or #rawUsername > 20 then
		return false, "Enter an exact Roblox username"
	end
	local success, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(rawUsername)
	end)
	if not success or type(userId) ~= "number" then
		return false, "Player was not found"
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		return true, PublicProfileService.fromPlayer(online)
	end
	if RunService:IsStudio() and not Config.studio.useLiveDataStore then
		return if mock[userId] then true else false, mock[userId] or "No public stats are available"
	end
	local readSuccess, result = pcall(function()
		return getStore():GetAsync(key(userId))
	end)
	if not readSuccess or result == nil then
		return false, "No public stats are available"
	end
	return true, result
end

return PublicProfileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RemoteService</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Template"):WaitForChild("Shared")
local Catalogs = require(Shared.Catalogs)
local Config = require(Shared.TemplateConfig)
local Calculations = require(Shared.Calculations)
local RemoteNames = require(Shared.RemoteNames)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local AfkService = require(script.Parent.AfkService)
local FeedbackService = require(script.Parent.FeedbackService)
local InventoryService = require(script.Parent.InventoryService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local LikesService = require(script.Parent.LikesService)
local ProfileService = require(script.Parent.ProfileService)
local PublicProfileService = require(script.Parent.PublicProfileService)
local RewardService = require(script.Parent.RewardService)
local SettingsService = require(script.Parent.SettingsService)

local RemoteService = {}
local limiter = RateLimiter.new()
local stateRemote: RemoteEvent
local requestRemote: RemoteEvent
local queryRemote: RemoteFunction

local function getOrCreate(className: string, name: string, parent: Instance): Instance
	local existing = parent:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	if existing then
		existing:Destroy()
	end
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = parent
	return instance
end

function RemoteService.snapshot(player: Player): any
	local profile = ProfileService.snapshot(player)
	if profile == nil then
		return nil
	end
	local likes = LikesService.getLikes()
	return {
		profile = profile,
		catalog = Catalogs.items,
		features = Config.features,
		version = Config.version,
		serverTime = os.time(),
		friendBonus = Calculations.friendBonus(
			profile.social.friendCountInServer,
			Config.economy.friendBonusPerFriend,
			Config.economy.friendBonusCap
		),
		premiumBonus = if profile.entitlements.premium then Config.economy.premiumBonus else 0,
		potionMultiplier = Calculations.potionMultiplier(profile.boosts, os.time()),
		offline = RewardService.getPendingOffline(player),
		likes = likes,
		dailyRewards = Config.rewards.daily,
		likesMilestones = Config.rewards.likesMilestones,
		serverLeaderboard = LeaderboardService.serverBoard(),
		productAvailability = {
			coinPackSmall = Config.products.coinPackSmall.id > 0,
			coinPackLarge = Config.products.coinPackLarge.id > 0,
			extendedOffline = Config.economy.extendedOfflineGamePassId > 0,
		},
		productIds = {
			coinPackSmall = Config.products.coinPackSmall.id,
			coinPackLarge = Config.products.coinPackLarge.id,
			extendedOffline = Config.economy.extendedOfflineGamePassId,
		},
		integrationAvailability = {
			community = Config.features.communityVerification and Config.identity.communityId > 0,
			discord = false,
			guilds = false,
			notificationWorker = Config.notifications.workerUrl ~= "",
		},
	}
end

function RemoteService.publish(player: Player)
	if stateRemote and player.Parent then
		stateRemote:FireClient(player, { kind = "Snapshot", data = RemoteService.snapshot(player) })
	end
end

local function result(player: Player, ok: boolean, message: string, data: any?)
	stateRemote:FireClient(player, { kind = "Result", ok = ok, message = message, data = data })
	RemoteService.publish(player)
end

local function handleRequest(player: Player, packet: any)
	if type(packet) ~= "table" or type(packet.action) ~= "string" then
		return
	end
	local action = packet.action
	local payload = packet.payload
	if not limiter:allow(player, action, 6, 1) then
		result(player, false, "Please slow down")
		return
	end

	if action == "BuyItem" then
		local itemId = if type(payload) == "table" then payload.itemId else nil
		if type(itemId) ~= "string" or #itemId > 64 then
			result(player, false, "Invalid item")
			return
		end
		result(player, InventoryService.buy(player, itemId))
	elseif action == "UseItem" then
		local itemId = if type(payload) == "table" then payload.itemId else nil
		if type(itemId) ~= "string" or #itemId > 64 then
			result(player, false, "Invalid item")
			return
		end
		result(player, InventoryService.consume(player, itemId))
	elseif action == "ToggleEquip" then
		local itemId = if type(payload) == "table" then payload.itemId else nil
		if type(itemId) ~= "string" or #itemId > 64 then
			result(player, false, "Invalid item")
			return
		end
		result(player, InventoryService.toggleEquip(player, itemId))
	elseif action == "ClaimDaily" then
		result(player, RewardService.claimDaily(player))
	elseif action == "ClaimOffline" then
		result(player, RewardService.claimOffline(player))
	elseif action == "RedeemCode" then
		result(
			player,
			RewardService.redeemCode(player, if type(payload) == "table" then payload.code else nil)
		)
	elseif action == "UpdateSetting" then
		if type(payload) ~= "table" then
			result(player, false, "Invalid setting")
			return
		end
		result(player, SettingsService.update(player, payload.key, payload.value))
	elseif action == "SubmitFeedback" then
		if type(payload) ~= "table" then
			result(player, false, "Invalid feedback")
			return
		end
		result(player, FeedbackService.submit(player, payload.category, payload.message))
	elseif action == "AfkRollover" then
		local profile = ProfileService.get(player)
		if profile == nil or not profile.settings.afKRollOver then
			result(player, false, "AFK rollover is disabled")
			return
		end
		result(player, AfkService.rollOver(player))
	else
		result(player, false, "Unknown request")
	end
end

local function handleQuery(player: Player, action: any, payload: any): any
	if type(action) ~= "string" or not limiter:allow(player, `query:{action}`, 4, 0.5) then
		return { ok = false, message = "Request unavailable" }
	end
	if action == "InitialState" then
		return { ok = true, data = RemoteService.snapshot(player) }
	elseif action == "SearchProfile" then
		local username = if type(payload) == "table" then payload.username else nil
		local ok, data = PublicProfileService.find(username)
		return { ok = ok, data = if ok then data else nil, message = if ok then nil else data }
	elseif action == "GlobalLeaderboard" then
		local ok, data = LeaderboardService.globalBoard()
		return { ok = ok, data = if ok then data else nil, message = if ok then nil else data }
	end
	return { ok = false, message = "Unknown query" }
end

function RemoteService.initialize()
	local folder = ReplicatedStorage:FindFirstChild(RemoteNames.folder)
	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = RemoteNames.folder
		folder.Parent = ReplicatedStorage
	end
	requestRemote = getOrCreate("RemoteEvent", RemoteNames.request, folder) :: RemoteEvent
	stateRemote = getOrCreate("RemoteEvent", RemoteNames.state, folder) :: RemoteEvent
	queryRemote = getOrCreate("RemoteFunction", RemoteNames.query, folder) :: RemoteFunction
	requestRemote.OnServerEvent:Connect(handleRequest)
	queryRemote.OnServerInvoke = handleQuery
	ProfileService.changed:Connect(function(player)
		LeaderboardService.updateLeaderstats(player)
		RemoteService.publish(player)
	end)
end

function RemoteService.broadcastAnnouncement(message: string)
	stateRemote:FireAllClients({ kind = "Announcement", message = message })
end

function RemoteService.forget(player: Player)
	limiter:forget(player)
end

return RemoteService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[--!strict

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local Calculations = require(Shared.Calculations)
local ProfileService = require(script.Parent.ProfileService)
local EconomyService = require(script.Parent.EconomyService)
local InventoryService = require(script.Parent.InventoryService)
local LikesService = require(script.Parent.LikesService)
local EconomyRateProvider = require(script.Parent.Parent.Providers.DefaultEconomyRateProvider)

local RewardService = {}
local pendingOffline: { [Player]: { amount: number, elapsed: number } } = {}

function RewardService.prepareOffline(player: Player)
	local profile = ProfileService.get(player)
	if profile == nil then
		return
	end
	local capHours = if profile.entitlements.extendedOffline
		then Config.economy.paidOfflineCapHours
		else Config.economy.freeOfflineCapHours
	local amount, elapsed = Calculations.offlineEarnings(
		profile.lastSeenAt,
		os.time(),
		profile.offlineRateSnapshot,
		capHours,
		EconomyService.permanentOfflineMultiplier(player)
	)
	pendingOffline[player] = { amount = amount, elapsed = elapsed }
	profile.lastSeenAt = os.time()
	profile.offlineRateSnapshot = EconomyRateProvider.getRate(player)
	ProfileService.markDirty(player, "offline:prepared")
end

function RewardService.getPendingOffline(player: Player): { amount: number, elapsed: number }
	return pendingOffline[player] or { amount = 0, elapsed = 0 }
end

function RewardService.claimOffline(player: Player): (boolean, string)
	local pending = pendingOffline[player]
	if pending == nil or pending.amount <= 0 then
		return false, "No offline earnings are ready"
	end
	pendingOffline[player] = nil
	EconomyService.awardRaw(player, pending.amount, "offline")
	return true, `Claimed {pending.amount} Coins`
end

function RewardService.claimDaily(player: Player): (boolean, string)
	local profile = ProfileService.get(player)
	if profile == nil then
		return false, "Profile is not loaded"
	end
	local canClaim, nextStreak = Calculations.dailyClaim(
		profile.daily.lastClaimDay,
		profile.daily.streak,
		os.time(),
		#Config.rewards.daily
	)
	if not canClaim then
		return false, "Daily reward already claimed"
	end
	local amount = Config.rewards.daily[nextStreak]
	profile.daily.lastClaimDay = Calculations.utcDay(os.time())
	profile.daily.streak = nextStreak
	EconomyService.awardRaw(player, amount, "daily")
	ProfileService.markDirty(player, "daily:claim")
	return true, `Day {nextStreak}: {amount} Coins`
end

function RewardService.redeemCode(player: Player, rawCode: any): (boolean, string)
	local code = Calculations.normalizeCode(rawCode)
	local profile = ProfileService.get(player)
	if code == nil or profile == nil then
		return false, "Invalid code"
	end
	local reward = Config.rewards.codes[code]
	if reward == nil then
		return false, "Code does not exist"
	end
	if profile.redemptions[code] then
		return false, "Code already redeemed"
	end
	for _, milestone in Config.rewards.likesMilestones do
		if milestone.code == code then
			local likes = LikesService.getLikes()
			if (likes.value or 0) < milestone.likes then
				return false, `Code unlocks at {milestone.likes} likes`
			end
			break
		end
	end
	profile.redemptions[code] = true
	if reward.coins and reward.coins > 0 then
		EconomyService.awardRaw(player, reward.coins, `code:{code}`)
	end
	if reward.itemId and reward.quantity then
		InventoryService.grant(player, reward.itemId, reward.quantity)
	end
	ProfileService.markDirty(player, `code:{code}`)
	return true, "Code redeemed"
end

function RewardService.forget(player: Player)
	pendingOffline[player] = nil
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[--!strict

local ProfileService = require(script.Parent.ProfileService)

local SettingsService = {}

function SettingsService.update(player: Player, key: any, value: any): (boolean, string)
	local profile = ProfileService.get(player)
	if profile == nil or type(key) ~= "string" then
		return false, "Profile is not loaded"
	end
	if key == "musicVolume" or key == "sfxVolume" then
		if type(value) ~= "number" or value ~= value then
			return false, "Volume must be a number"
		end
		profile.settings[key] = math.clamp(value, 0, 1)
	elseif key == "uiScale" then
		if type(value) ~= "number" or value ~= value then
			return false, "UI scale must be a number"
		end
		profile.settings.uiScale = math.clamp(value, 0.8, 1.2)
	elseif
		key == "reducedMotion"
		or key == "announcements"
		or key == "afKRollOver"
		or key == "notifications"
	then
		if type(value) ~= "boolean" then
			return false, "Setting must be on or off"
		end
		profile.settings[key] = value
	else
		return false, "Setting is not supported"
	end
	ProfileService.markDirty(player, `settings:{key}`)
	return true, "Setting updated"
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">SocialService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local ProfileService = require(script.Parent.ProfileService)
local CommunityVerificationProvider = require(script.Parent.Parent.Providers.CommunityVerificationProvider)

local SocialService = {}

local function countFriends(player: Player): number
	local count = 0
	for _, other in Players:GetPlayers() do
		if other ~= player then
			local success, isFriend = pcall(function()
				return player:IsFriendsWithAsync(other.UserId)
			end)
			if success and isFriend then
				count += 1
			end
		end
	end
	return count
end

function SocialService.refresh(player: Player)
	local profile = ProfileService.get(player)
	if profile == nil then
		return
	end
	profile.entitlements.premium = player.MembershipType == Enum.MembershipType.Premium
	profile.social.friendCountInServer = countFriends(player)

	local verification = CommunityVerificationProvider.verify(player)
	profile.social.communityVerified = verification.status == "available" and verification.value == true
	ProfileService.markDirty(player, "social:refresh")
end

function SocialService.refreshAll()
	task.spawn(function()
		for _, player in Players:GetPlayers() do
			SocialService.refresh(player)
		end
	end)
end

return SocialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">StoreService</string>
            <string name="Source"><![CDATA[--!strict

local MarketplaceService = game:GetService("MarketplaceService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared")
local Config = require(Shared.TemplateConfig)
local ReceiptLedger = require(Shared.ReceiptLedger)
local ProfileService = require(script.Parent.ProfileService)
local EconomyService = require(script.Parent.EconomyService)

local StoreService = {}

local function amountForProduct(productId: number): number?
	if productId == Config.products.coinPackSmall.id and productId > 0 then
		return Config.products.coinPackSmall.coins
	elseif productId == Config.products.coinPackLarge.id and productId > 0 then
		return Config.products.coinPackLarge.coins
	end
	return nil
end

function StoreService.refreshEntitlements(player: Player)
	local profile = ProfileService.get(player)
	if profile == nil then
		return
	end
	if Config.economy.extendedOfflineGamePassId <= 0 then
		profile.entitlements.extendedOffline = false
		return
	end
	local success, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(
			player.UserId,
			Config.economy.extendedOfflineGamePassId
		)
	end)
	if success then
		profile.entitlements.extendedOffline = owns
		ProfileService.markDirty(player, "entitlement:offline")
	end
end

function StoreService.initialize()
	MarketplaceService.ProcessReceipt = function(receiptInfo)
		local player = game:GetService("Players"):GetPlayerByUserId(receiptInfo.PlayerId)
		if player == nil then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local profile = ProfileService.get(player)
		local amount = amountForProduct(receiptInfo.ProductId)
		if profile == nil or amount == nil then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local receiptKey = ReceiptLedger.key(receiptInfo.PurchaseId)
		if ReceiptLedger.claim(profile.redemptions, receiptInfo.PurchaseId) then
			EconomyService.awardRaw(player, amount, `product:{receiptInfo.ProductId}`)
			ProfileService.markDirty(player, receiptKey)
		end
		if not ProfileService.save(player) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if purchased and gamePassId == Config.economy.extendedOfflineGamePassId then
			StoreService.refreshEntitlements(player)
		end
	end)
end

return StoreService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="44">
