      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">StarterExample</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict

local ServerScriptService = game:GetService("ServerScriptService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local EconomyService = require(ServerScriptService:WaitForChild("TemplateServer").Services.EconomyService)

local pad = Instance.new("Part")
pad.Name = "ExampleEarningPad"
pad.Anchored = true
pad.CanCollide = true
pad.Color = Color3.fromRGB(80, 135, 255)
pad.Material = Enum.Material.Neon
pad.Position = Vector3.new(0, 1, -18)
pad.Size = Vector3.new(12, 1, 12)
pad.Parent = Workspace

local prompt = Instance.new("ProximityPrompt")
prompt.ActionText = "Earn 10 Coins"
prompt.ObjectText = "Template Demo"
prompt.HoldDuration = 0.25
prompt.MaxActivationDistance = 12
prompt.RequiresLineOfSight = false
prompt.Parent = pad

local billboard = Instance.new("BillboardGui")
billboard.Name = "StarterSign"
billboard.AlwaysOnTop = true
billboard.Size = UDim2.fromOffset(320, 80)
billboard.StudsOffset = Vector3.new(0, 5, 0)
billboard.Parent = pad

local label = Instance.new("TextLabel")
label.BackgroundColor3 = Color3.fromRGB(22, 25, 42)
label.BackgroundTransparency = 0.1
label.BorderSizePixel = 0
label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
label.Size = UDim2.fromScale(1, 1)
label.Text = "PLAYABLE STARTER\nUse the prompt to exercise the template economy"
label.TextColor3 = Color3.fromRGB(248, 249, 255)
label.TextScaled = true
label.TextWrapped = true
label.Parent = billboard
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = label

local lastAwardAt: { [Player]: number } = {}
prompt.Triggered:Connect(function(player)
	local now = os.clock()
	if now - (lastAwardAt[player] or 0) < 1 then
		return
	end
	lastAwardAt[player] = now
	EconomyService.award(player, 10, "starter:earning-pad")
end)

Players.PlayerRemoving:Connect(function(player)
	lastAwardAt[player] = nil
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="22">
      <Properties>
        <string name="Name">TemplateServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")

local Services = script.Services
local AnnouncementService = require(Services.AnnouncementService)
local FeedbackService = require(Services.FeedbackService)
local LeaderboardService = require(Services.LeaderboardService)
local NotificationService = require(Services.NotificationService)
local ProfileService = require(Services.ProfileService)
local PublicProfileService = require(Services.PublicProfileService)
local RemoteService = require(Services.RemoteService)
local RewardService = require(Services.RewardService)
local SocialService = require(Services.SocialService)
local StoreService = require(Services.StoreService)
local EconomyRateProvider = require(script.Providers.DefaultEconomyRateProvider)

RemoteService.initialize()
StoreService.initialize()
ProfileService.startAutosave()
LeaderboardService.start()
AnnouncementService.start(RemoteService.broadcastAnnouncement)

local function playerAdded(player: Player)
	task.spawn(function()
		local profile = ProfileService.load(player)
		if profile == nil then
			if player.Parent then
				player:Kick("Your data could not be loaded safely. Please rejoin.")
			end
			return
		end
		NotificationService.cancel(player)
		StoreService.refreshEntitlements(player)
		SocialService.refresh(player)
		player:GetPropertyChangedSignal("MembershipType"):Connect(function()
			SocialService.refresh(player)
		end)
		RewardService.prepareOffline(player)
		LeaderboardService.updateLeaderstats(player)
		PublicProfileService.publish(player)
		RemoteService.publish(player)
		SocialService.refreshAll()
	end)
end

local function playerRemoving(player: Player)
	NotificationService.scheduleOnLeave(player)
	PublicProfileService.publish(player)
	LeaderboardService.flushPlayer(player)
	RewardService.forget(player)
	FeedbackService.forget(player)
	RemoteService.forget(player)
	ProfileService.release(player)
	task.defer(SocialService.refreshAll)
end

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(playerRemoving)
for _, player in Players:GetPlayers() do
	playerAdded(player)
end

task.spawn(function()
	while true do
		task.wait(60)
		for _, player in Players:GetPlayers() do
			local profile = ProfileService.get(player)
			if profile then
				profile.stats.playSeconds += 60
				profile.lastSeenAt = os.time()
				profile.offlineRateSnapshot = EconomyRateProvider.getRate(player)
				ProfileService.markDirty(player, "playtime")
				PublicProfileService.publish(player)
			end
		end
	end
end)

game:BindToClose(function()
	ProfileService.close()
end)
]]></string>
      </Properties>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Providers</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CommunityVerificationProvider</string>
            <string name="Source"><![CDATA[--!strict

local Config = require(
	game:GetService("ReplicatedStorage"):WaitForChild("Template"):WaitForChild("Shared").TemplateConfig
)

local Provider = {}

function Provider.verify(player: Player): { status: string, value: boolean?, reason: string? }
	if not Config.features.communityVerification or Config.identity.communityId <= 0 then
		return { status = "disabled", value = false, reason = "Community ID is not configured" }
	end
	local success, verified = pcall(function()
		return player:IsInGroupAsync(Config.identity.communityId)
	end)
	if not success then
		return { status = "error", value = false, reason = "Roblox community lookup failed" }
	end
	return { status = "available", value = verified }
end

return Provider
]]></string>
          </Properties>
        </Item>
